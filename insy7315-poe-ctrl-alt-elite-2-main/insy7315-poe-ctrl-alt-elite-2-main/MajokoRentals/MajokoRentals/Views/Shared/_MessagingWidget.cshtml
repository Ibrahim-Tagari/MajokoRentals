@*
    Messaging Widget Partial View
    Can be included in dashboards to show quick access to messaging features
*@

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h6 class="mb-0">
            <i class="bi bi-chat-dots"></i> Messages
        </h6>
    </div>
    <div class="card-body">
        <div class="d-grid gap-2">
            <a asp-controller="Messaging" asp-action="MyChats" class="btn btn-outline-primary">
                <i class="bi bi-inbox"></i> My Conversations
                @* Add badge for unread messages if available *@
            </a>

            @if (User.IsInRole("Tenant"))
            {
                <a asp-controller="Messaging" asp-action="RequestChat" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> New Chat Request
                </a>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager") || User.IsInRole("Caretaker"))
            {
                <a asp-controller="Messaging" asp-action="PendingRequests" class="btn btn-warning">
                    <i class="bi bi-clock-history"></i> Pending Requests
                </a>
            }
        </div>
    </div>
</div>
