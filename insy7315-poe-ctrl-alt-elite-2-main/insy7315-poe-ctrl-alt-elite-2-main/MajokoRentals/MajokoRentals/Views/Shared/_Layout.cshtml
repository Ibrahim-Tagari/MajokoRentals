<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr Majoko Projects</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Dr Majoko Projects" height="80" class="me-2">Dr Majoko Projects
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Properties" asp-action="Index">
                                <i class="bi bi-building me-1"></i>Properties
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager"))
                            {
                                <!-- Management Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-briefcase me-1"></i>Management
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leases" asp-action="Index">
                                                <i class="bi bi-file-text me-2"></i>Leases
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Payments" asp-action="Invoices">
                                                <i class="bi bi-receipt me-2"></i>Invoices
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="RentalApplications" asp-action="Index">
                                                <i class="bi bi-file-earmark-text me-2"></i>Applications
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Maintenance" asp-action="Index">
                                                <i class="bi bi-tools me-2"></i>Maintenance
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Announcements" asp-action="Index">
                                                <i class="bi bi-megaphone me-2"></i>Announcements
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Messaging" asp-action="MyChats">
                                                <i class="bi bi-chat-dots me-2"></i>Messages
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Messaging" asp-action="PendingRequests">
                                                <i class="bi bi-clock-history me-2"></i>Pending Requests
                                                <span class="badge bg-warning text-dark ms-2 pending-chat-badge" style="display:none;">0</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Admin Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock me-1"></i>Admin
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="CreateUser">
                                                <i class="bi bi-person-plus-fill me-2"></i>Create User
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Tenant"))
                            {
                                <!-- Tenant Portal Dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-person-workspace me-1"></i>My Portal
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="RentalApplications" asp-action="MyApplications">
                                                <i class="bi bi-file-earmark-person me-2"></i>My Applications
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leases" asp-action="MyLease">
                                                <i class="bi bi-file-text me-2"></i>My Lease
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Payments" asp-action="MyInvoices">
                                                <i class="bi bi-receipt me-2"></i>My Invoices
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Maintenance" asp-action="MyRequests">
                                                <i class="bi bi-tools me-2"></i>Maintenance
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Announcements" asp-action="MyAnnouncements">
                                                <i class="bi bi-megaphone me-2"></i>Announcements
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Messaging" asp-action="MyChats">
                                                <i class="bi bi-chat-dots me-2"></i>My Messages
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Messaging" asp-action="RequestChat">
                                                <i class="bi bi-plus-circle me-2"></i>New Chat Request
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Caretaker"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Maintenance" asp-action="Index">
                                        <i class="bi bi-tools me-1"></i>My Assignments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Announcements" asp-action="MyAnnouncements">
                                        <i class="bi bi-megaphone me-1"></i>Announcements
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-chat-dots me-1"></i>Messages
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Messaging" asp-action="MyChats">
                                                <i class="bi bi-inbox me-2"></i>My Chats
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Messaging" asp-action="PendingRequests">
                                                <i class="bi bi-clock-history me-2"></i>Pending Requests
                                                <span class="badge bg-warning text-dark ms-2 pending-chat-badge" style="display:none;">0</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <!-- For Applicants or users without specific roles -->
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="RentalApplications" asp-action="MyApplications">
                                        <i class="bi bi-file-earmark-person me-1"></i>My Applications
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    @if (!string.IsNullOrEmpty(User.FindFirst("profile_image")?.Value))
                                    {
                                        <img src="@User.FindFirst("profile_image")!.Value" alt="Profile" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle me-1"></i>
                                    }
                                    @User.Identity!.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary ms-2" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        <div class="container my-4">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-5">
        <div class="container py-4">
            <div class="text-center small">
                &copy; @DateTime.Now.Year Dr Majoko Projects (Pty) Ltd. All rights reserved.
            </div>
        </div>
    </footer>

    @* Floating Chatbot Widget *@
    <partial name="_ChatWidget" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>

    @* Pending Chat Requests Badge Update *@
    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("PropertyManager") || User.IsInRole("Caretaker")))
    {
        <script>
            // Update pending chat requests badge
            function updatePendingChatBadge() {
                $.ajax({
                    url: '@Url.Action("GetPendingChatCount", "Messaging")',
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.count > 0) {
                            $('.pending-chat-badge').text(response.count).show();
                        } else {
                            $('.pending-chat-badge').hide();
                        }
                    },
                    error: function() {
                        console.log('Failed to fetch pending chat count');
                    }
                });
            }

            // Update on page load
            $(document).ready(function() {
                updatePendingChatBadge();
                // Refresh every 30 seconds
                setInterval(updatePendingChatBadge, 30000);
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
