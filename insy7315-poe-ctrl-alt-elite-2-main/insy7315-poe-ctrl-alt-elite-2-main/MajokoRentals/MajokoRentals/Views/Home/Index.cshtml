@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="row align-items-center mb-5">
    <div class="col-lg-6">
        <h1 class="display-4 fw-bold text-accent mb-3">
            Find Your Perfect Home with Dr Majoko Projects
        </h1>
        <p class="lead text-muted mb-4">
            Professional property management and quality rental homes across Gauteng.
            Discover comfortable living in Blue Hills, Birchleigh, and Florida.
        </p>
        <div class="d-grid gap-2 d-md-flex">
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>Get Started
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </a>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800"
             alt="Modern Home" class="img-fluid rounded shadow" />
    </div>
</div>

<!-- Features Section -->
<div class="row g-4 my-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-house-check text-accent" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">Quality Properties</h5>
                <p class="card-text text-muted">
                    Well-maintained properties in prime locations across Gauteng
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-credit-card text-accent" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">Easy Payments</h5>
                <p class="card-text text-muted">
                    Convenient online rent payment and tracking system
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-tools text-accent" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">24/7 Maintenance</h5>
                <p class="card-text text-muted">
                    Quick response to maintenance requests with dedicated support
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-robot text-accent" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">AI Assistant</h5>
                <p class="card-text text-muted">
                    Get instant answers to your questions with our AI chatbot
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-globe text-accent" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">Multi-Language</h5>
                <p class="card-text text-muted">
                    Support in English, Zulu, and Sesotho
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-phone text-accent" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">Mobile App</h5>
                <p class="card-text text-muted">
                    Manage everything on-the-go with our mobile app
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="row my-5">
    <div class="col-12">
        <div class="card bg-primary text-white shadow-lg">
            <div class="card-body p-5 text-center">
                <h2 class="fw-bold mb-3">Ready to Find Your New Home?</h2>
                <p class="lead mb-4">
                    Join hundreds of satisfied tenants enjoying quality living with Dr Majoko Projects
                </p>
                @if (!User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg px-5">
                        <i class="bi bi-person-plus me-2"></i>Register Now
                    </a>
                }
            </div>
        </div>
    </div>
</div>
