@model MajokoRentals.Core.ViewModels.AssignMaintenanceRequestViewModel

@{
    ViewData["Title"] = "Assign Maintenance Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <i class="bi bi-person-plus me-2"></i>Assign Maintenance Request
                </h2>

                <div class="alert alert-info mb-4">
                    <strong>Request:</strong> @Model.Title<br />
                    <strong>Property:</strong> @Model.PropertyName
                </div>

                <form asp-action="Assign" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="RequestId" />
                    <input type="hidden" asp-for="Title" />
                    <input type="hidden" asp-for="PropertyName" />

                    <div class="mb-4">
                        <label asp-for="AssignedToId" class="form-label"></label>
                        <select asp-for="AssignedToId" class="form-select" asp-items="@ViewBag.Caretakers">
                            <option value="">-- Select Caretaker --</option>
                        </select>
                        <span asp-validation-for="AssignedToId" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="EstimatedCost" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Add any special instructions or notes for the caretaker..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        The assigned caretaker will receive an email notification with the request details.
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                        <a asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-person-plus me-1"></i>Assign Request
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
