@model MajokoRentals.Core.ViewModels.MaintenanceRequestDetailsViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Maintenance Request Details";
}

<div class="mb-4">
    @if (User.IsInRole("Tenant"))
    {
        <a asp-action="MyRequests" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to My Requests
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    }
    @if ((User.IsInRole("Admin") || User.IsInRole("PropertyManager")) && Model.Status == MaintenanceStatus.Pending)
    {
        <a asp-action="Assign" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-person-plus me-1"></i>Assign
        </a>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager") || User.IsInRole("Caretaker"))
    {
        @if (Model.Status == MaintenanceStatus.Pending)
        {
            <form asp-action="UpdateStatus" asp-antiforgery="true" method="post" style="display: inline;">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@((int)MaintenanceStatus.InProgress)" />
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-play-circle me-1"></i>Start Work
                </button>
            </form>
        }
        else if (Model.Status == MaintenanceStatus.InProgress)
        {
            <a asp-action="Complete" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bi bi-check-circle me-1"></i>Mark Complete
            </a>
        }
    }
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Request Details Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h2 class="fw-bold mb-2">@Model.Title</h2>
                        <p class="text-muted mb-0">
                            <i class="bi bi-calendar me-1"></i>Reported: @Model.ReportedDate.ToString("MMM dd, yyyy HH:mm")
                        </p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-@(Model.Priority == MaintenancePriority.Emergency ? "danger" : Model.Priority == MaintenancePriority.High ? "warning" : "info")" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            @Model.Priority Priority
                        </span>
                        <br />
                        <span class="badge bg-@(Model.Status == MaintenanceStatus.Resolved ? "success" : Model.Status == MaintenanceStatus.InProgress ? "warning" : "secondary") mt-2" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-2">PROPERTY:</h6>
                        <strong>@Model.PropertyName</strong><br />
                        @Model.PropertyAddress
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-2">REPORTED BY:</h6>
                        <strong>@Model.ReportedByName</strong><br />
                        @Model.ReportedByEmail
                    </div>
                </div>

                <hr />

                <div class="row mb-4">
                    <div class="col-md-4">
                        <strong>Category:</strong><br />
                        <span class="badge bg-secondary">@Model.Category</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="col-md-8">
                            <strong>Specific Location:</strong><br />
                            @Model.Location
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="mb-3">Description</h5>
                    <p class="text-break">@Model.Description</p>
                </div>

                <!-- Images -->
                @if (Model.ImageUrls.Any())
                {
                    <div class="mb-4">
                        <h5 class="mb-3">Images</h5>
                        <div class="row g-3">
                            @foreach (var imageUrl in Model.ImageUrls)
                            {
                                <div class="col-md-4">
                                    <a href="@imageUrl" target="_blank">
                                        <img src="@imageUrl" class="img-fluid rounded shadow-sm" alt="Maintenance Image" style="height: 200px; width: 100%; object-fit: cover;" />
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Resolution Notes -->
                @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
                {
                    <div class="alert alert-success">
                        <h6 class="alert-heading">Resolution Notes</h6>
                        <p class="mb-0">@Model.ResolutionNotes</p>
                    </div>
                }

                <!-- Completion Images -->
                @if (Model.CompletionImageUrls.Any())
                {
                    <div class="mb-4">
                        <h5 class="mb-3">Completion Images</h5>
                        <div class="row g-3">
                            @foreach (var imageUrl in Model.CompletionImageUrls)
                            {
                                <div class="col-md-4">
                                    <a href="@imageUrl" target="_blank">
                                        <img src="@imageUrl" class="img-fluid rounded shadow-sm" alt="Completion Image" style="height: 200px; width: 100%; object-fit: cover;" />
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Comments))
                {
                    <div class="alert alert-info">
                        <h6 class="alert-heading">Comments</h6>
                        <p class="mb-0" style="white-space: pre-line;">@Model.Comments</p>
                    </div>
                }
            </div>
        </div>

        @* Add Comment Section for Caretakers *@
        @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager") || User.IsInRole("Caretaker"))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-chat-left-text me-2"></i>Add Work Log / Comment</h5>
                    <form id="addCommentForm">
                        <div class="mb-3">
                            <textarea id="commentText" class="form-control" rows="3" placeholder="Add notes about the work performed, parts used, etc..." required></textarea>
                        </div>
                        <button type="button" id="submitComment" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add Comment
                        </button>
                    </form>
                    <div id="commentSuccess" class="alert alert-success mt-3" style="display: none;">
                        Comment added successfully!
                    </div>
                    <div id="commentError" class="alert alert-danger mt-3" style="display: none;">
                        Failed to add comment. Please try again.
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Status Timeline -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Status Timeline</h5>
                <div class="timeline">
                    <div class="timeline-item">
                        <i class="bi bi-circle-fill text-primary"></i>
                        <strong>Reported</strong><br />
                        <small>@Model.ReportedDate.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    @if (Model.AssignedDate.HasValue)
                    {
                        <div class="timeline-item">
                            <i class="bi bi-circle-fill text-warning"></i>
                            <strong>Assigned</strong><br />
                            <small>@Model.AssignedDate.Value.ToString("MMM dd, yyyy HH:mm")</small><br />
                            <small class="text-muted">to @Model.AssignedToName</small>
                        </div>
                    }
                    @if (Model.StartedDate.HasValue)
                    {
                        <div class="timeline-item">
                            <i class="bi bi-circle-fill text-info"></i>
                            <strong>Started</strong><br />
                            <small>@Model.StartedDate.Value.ToString("MMM dd, yyyy HH:mm")</small>
                        </div>
                    }
                    @if (Model.CompletedDate.HasValue)
                    {
                        <div class="timeline-item">
                            <i class="bi bi-circle-fill text-success"></i>
                            <strong>Completed</strong><br />
                            <small>@Model.CompletedDate.Value.ToString("MMM dd, yyyy HH:mm")</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cost Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Cost Information</h5>
                @if (Model.EstimatedCost.HasValue)
                {
                    <div class="mb-2">
                        <strong>Estimated Cost:</strong><br />
                        <span class="text-primary">R @Model.EstimatedCost.Value.ToString("N2")</span>
                    </div>
                }
                @if (Model.ActualCost.HasValue)
                {
                    <div>
                        <strong>Actual Cost:</strong><br />
                        <span class="text-success">R @Model.ActualCost.Value.ToString("N2")</span>
                    </div>
                }
                @if (!Model.EstimatedCost.HasValue && !Model.ActualCost.HasValue)
                {
                    <p class="text-muted mb-0">No cost information available</p>
                }
            </div>
        </div>

        <!-- Quick Info -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Quick Info</h5>
                <div class="mb-2">
                    <strong>Days Open:</strong> @Model.DaysOpen days
                </div>
                @if (Model.AssignedToName != null)
                {
                    <div class="mb-2">
                        <strong>Assigned To:</strong><br />
                        @Model.AssignedToName
                    </div>
                }
                <div>
                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-building me-1"></i>View Property
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 20px;
        }

        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: -23px;
            top: 15px;
            height: calc(100% - 5px);
            width: 2px;
            background: #dee2e6;
        }

        .timeline-item i {
            position: absolute;
            left: -28px;
            top: 2px;
            font-size: 0.7rem;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#submitComment').click(function() {
                var comment = $('#commentText').val().trim();

                if (!comment) {
                    alert('Please enter a comment');
                    return;
                }

                var requestId = '@Model.Id';
                var apiBaseUrl = '@Configuration["ApiSettings:BaseUrl"]';
                var firebaseToken = '@Context.Session.GetString("FirebaseToken")';

                $.ajax({
                    url: apiBaseUrl + '/api/maintenance/' + requestId + '/comments',
                    type: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + firebaseToken,
                        'Content-Type': 'application/json'
                    },
                    data: JSON.stringify({ comment: comment }),
                    success: function(response) {
                        $('#commentSuccess').show();
                        $('#commentError').hide();
                        $('#commentText').val('');

                        // Reload page after 1 second to show new comment
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    },
                    error: function(xhr, status, error) {
                        $('#commentError').show();
                        $('#commentSuccess').hide();
                        console.error('Error adding comment:', error);
                    }
                });
            });
        });
    </script>
}
