@model MajokoRentals.Core.ViewModels.RenewLeaseViewModel

@{
    ViewData["Title"] = "Renew Lease";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <i class="bi bi-arrow-clockwise me-2"></i>Renew Lease
                </h2>

                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    You are renewing the lease for <strong>@Model.PropertyName</strong> with tenant <strong>@Model.TenantName</strong>.
                </div>

                <form asp-action="Renew" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="LeaseId" />
                    <input type="hidden" asp-for="PropertyName" />
                    <input type="hidden" asp-for="TenantName" />

                    <!-- Current Lease Info -->
                    <h4 class="mb-3">Current Lease</h4>
                    <div class="card mb-4" style="background-color: var(--tertiary-bg); border: 1px solid var(--border-color);">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Current End Date:</strong><br />
                                    @Model.CurrentEndDate.ToString("MMM dd, yyyy")
                                </div>
                                <div class="col-md-6">
                                    <strong>Current Monthly Rent:</strong><br />
                                    R @Model.CurrentMonthlyRent.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- New Lease Period -->
                    <h4 class="mb-3">New Lease Period</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="NewStartDate" class="form-label"></label>
                            <input asp-for="NewStartDate" class="form-control" type="date" />
                            <span asp-validation-for="NewStartDate" class="text-danger"></span>
                            <small class="text-muted">Typically the day after the current lease ends</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEndDate" class="form-label"></label>
                            <input asp-for="NewEndDate" class="form-control" type="date" />
                            <span asp-validation-for="NewEndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Financial Details -->
                    <h4 class="mb-3">Financial Details</h4>
                    <div class="mb-4">
                        <label asp-for="MonthlyRent" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="MonthlyRent" class="text-danger"></span>
                        <small class="text-muted">You can adjust the rent for the renewed lease</small>
                    </div>

                    <!-- New Lease Document -->
                    <h4 class="mb-3">New Lease Document</h4>
                    <div class="mb-4">
                        <label asp-for="LeaseDocument" class="form-label"></label>
                        <input asp-for="LeaseDocument" class="form-control" type="file" accept=".pdf,.doc,.docx" />
                        <small class="text-muted">Upload the new signed lease agreement (PDF, DOC, DOCX - max 5MB)</small>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> Renewing will create a new lease agreement and mark the current lease as expired.
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                        <a asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-arrow-clockwise me-1"></i>Renew Lease
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Set default dates
        $(document).ready(function() {
            // When new start date changes, adjust end date to 1 year later
            $('#NewStartDate').on('change', function() {
                var startDate = new Date($(this).val());
                if (startDate) {
                    startDate.setFullYear(startDate.getFullYear() + 1);
                    var endDate = startDate.toISOString().split('T')[0];
                    $('#NewEndDate').val(endDate);
                }
            });
        });
    </script>
}
