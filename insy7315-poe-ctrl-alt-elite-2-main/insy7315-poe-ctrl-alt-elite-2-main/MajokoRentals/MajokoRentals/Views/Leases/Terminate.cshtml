@model MajokoRentals.Core.ViewModels.TerminateLeaseViewModel

@{
    ViewData["Title"] = "Terminate Lease";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                    <h2 class="mt-3 fw-bold">Terminate Lease?</h2>
                </div>

                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This action will terminate the lease and make the property available. The tenant will be notified via email.
                </div>

                <div class="card border-secondary mb-4" style="background-color: #f8f9fa;">
                    <div class="card-body">
                        <h5 class="text-dark">Lease Details</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <strong class="text-dark">Property:</strong><br />
                                <span class="text-dark">@Model.PropertyName</span>
                            </div>
                            <div class="col-md-6">
                                <strong class="text-dark">Tenant:</strong><br />
                                <span class="text-dark">@Model.TenantName</span>
                            </div>
                            <div class="col-md-6">
                                <strong class="text-dark">Lease Period:</strong><br />
                                <span class="text-dark">@Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="col-md-6">
                                <strong class="text-dark">Monthly Rent:</strong><br />
                                <span class="text-dark">R @Model.MonthlyRent.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Terminate" method="post">
                    <input type="hidden" asp-for="LeaseId" />

                    <div class="mb-3">
                        <label asp-for="TerminationDate" class="form-label">Termination Date</label>
                        <input asp-for="TerminationDate" class="form-control" type="date" />
                        <span asp-validation-for="TerminationDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label">Reason for Termination (Optional)</label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Enter reason for termination..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-outline-secondary btn-lg px-5">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-5">
                                <i class="bi bi-x-circle me-1"></i>Yes, Terminate
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
