@{
    ViewData["Title"] = "No Active Lease";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body p-5">
                <i class="bi bi-file-text text-muted" style="font-size: 4rem;"></i>
                <h2 class="mt-3 fw-bold">No Active Lease</h2>
                <p class="text-muted mt-3">
                    You do not have an active lease at the moment.
                    If you believe this is an error, please contact the property manager.
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house-door me-2"></i>Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
