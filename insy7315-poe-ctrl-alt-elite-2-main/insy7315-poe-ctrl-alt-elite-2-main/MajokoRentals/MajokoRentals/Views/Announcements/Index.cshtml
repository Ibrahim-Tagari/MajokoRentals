@model List<MajokoRentals.Core.DTOs.AnnouncementDto>

@{
    ViewData["Title"] = "Manage Announcements";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-megaphone me-2"></i>Manage Announcements
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Create New Announcement
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var announcement in Model)
            {
                var priorityClass = announcement.Priority switch
                {
                    MajokoRentals.Core.Models.AnnouncementPriority.Urgent => "border-danger",
                    MajokoRentals.Core.Models.AnnouncementPriority.Important => "border-warning",
                    _ => "border-secondary"
                };

                var typeIcon = announcement.Type switch
                {
                    MajokoRentals.Core.Models.AnnouncementType.Emergency => "bi-exclamation-triangle-fill text-danger",
                    MajokoRentals.Core.Models.AnnouncementType.Maintenance => "bi-tools text-warning",
                    MajokoRentals.Core.Models.AnnouncementType.Inspection => "bi-clipboard-check text-info",
                    MajokoRentals.Core.Models.AnnouncementType.Event => "bi-calendar-event text-success",
                    MajokoRentals.Core.Models.AnnouncementType.RentReminder => "bi-cash-coin text-accent",
                    MajokoRentals.Core.Models.AnnouncementType.PolicyUpdate => "bi-file-earmark-text text-primary",
                    _ => "bi-info-circle text-secondary"
                };

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm @priorityClass" style="border-width: 2px;">
                        <div class="card-header d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1">
                                    <i class="@typeIcon me-2"></i>@announcement.Title
                                </h5>
                                <small class="text-muted">@announcement.Type</small>
                            </div>
                            @if (announcement.Priority == MajokoRentals.Core.Models.AnnouncementPriority.Urgent)
                            {
                                <span class="badge bg-danger">Urgent</span>
                            }
                            else if (announcement.Priority == MajokoRentals.Core.Models.AnnouncementPriority.Important)
                            {
                                <span class="badge bg-warning text-dark">Important</span>
                            }
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                @(announcement.Content.Length > 150
                                    ? announcement.Content.Substring(0, 150) + "..."
                                    : announcement.Content)
                            </p>

                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>By @announcement.CreatedByName
                                </small>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>@announcement.CreatedDate.ToString("MMM dd, yyyy")
                                </small>
                            </div>

                            @if (announcement.ExpiryDate.HasValue)
                            {
                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>Expires: @announcement.ExpiryDate.Value.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            }

                            <div class="mb-2">
                                <small>
                                    <i class="bi bi-eye me-1"></i>@announcement.ViewCount view@(announcement.ViewCount != 1 ? "s" : "")
                                </small>
                            </div>

                            <div class="mb-3">
                                @if (announcement.ForAllTenants)
                                {
                                    <span class="badge bg-info me-1">All Tenants</span>
                                }
                                @if (announcement.ForAllCaretakers)
                                {
                                    <span class="badge bg-success me-1">All Caretakers</span>
                                }
                                @if (announcement.ForAllManagers)
                                {
                                    <span class="badge bg-primary me-1">All Managers</span>
                                }
                            </div>

                            @if (!announcement.IsActive)
                            {
                                <div class="alert alert-secondary py-1 px-2 mb-2">
                                    <small><i class="bi bi-x-circle me-1"></i>Inactive</small>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Details" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                <div>
                                    <a asp-action="Edit" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@announcement.Id">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div class="modal fade" id="deleteModal-@announcement.Id" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Confirm Delete</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete the announcement "<strong>@announcement.Title</strong>"?
                                This action cannot be undone.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <form asp-action="Delete" asp-route-id="@announcement.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body text-center py-5">
                <i class="bi bi-megaphone" style="font-size: 4rem; color: var(--accent-gold);"></i>
                <h4 class="mt-3">No Announcements Yet</h4>
                <p class="text-muted">Create your first broadcast announcement to communicate with tenants, caretakers, and managers.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle me-1"></i>Create First Announcement
                </a>
            </div>
        </div>
    }
</div>
