@model MajokoRentals.Core.DTOs.AnnouncementDto

@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("PropertyManager");

    var priorityBadge = Model.Priority switch
    {
        MajokoRentals.Core.Models.AnnouncementPriority.Urgent => "<span class='badge bg-danger'>Urgent</span>",
        MajokoRentals.Core.Models.AnnouncementPriority.Important => "<span class='badge bg-warning text-dark'>Important</span>",
        _ => "<span class='badge bg-secondary'>Normal</span>"
    };

    var typeIcon = Model.Type switch
    {
        MajokoRentals.Core.Models.AnnouncementType.Emergency => "bi-exclamation-triangle-fill text-danger",
        MajokoRentals.Core.Models.AnnouncementType.Maintenance => "bi-tools text-warning",
        MajokoRentals.Core.Models.AnnouncementType.Inspection => "bi-clipboard-check text-info",
        MajokoRentals.Core.Models.AnnouncementType.Event => "bi-calendar-event text-success",
        MajokoRentals.Core.Models.AnnouncementType.RentReminder => "bi-cash-coin",
        MajokoRentals.Core.Models.AnnouncementType.PolicyUpdate => "bi-file-earmark-text text-primary",
        _ => "bi-info-circle text-secondary"
    };
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-lg">
                <!-- Header -->
                <div class="card-header" style="background-color: var(--accent-gold);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h3 class="mb-2" style="color: var(--primary-bg);">
                                <i class="@typeIcon me-2"></i>@Model.Title
                            </h3>
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="badge bg-light text-dark">@Model.Type</span>
                                @Html.Raw(priorityBadge)
                                @if (!Model.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body">
                    <!-- Image if available -->
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-4 text-center">
                            <img src="@Model.ImageUrl" alt="Announcement image" class="img-fluid rounded" style="max-height: 400px;" />
                        </div>
                    }

                    <!-- Content -->
                    <div class="announcement-content mb-4">
                        <p style="white-space: pre-wrap; font-size: 1.1rem; line-height: 1.6;">@Model.Content</p>
                    </div>

                    <hr class="my-4" />

                    <!-- Metadata -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">
                                <i class="bi bi-info-circle me-2"></i>Announcement Details
                            </h6>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="bi bi-person me-2"></i>
                                    <strong>Posted by:</strong> @Model.CreatedByName
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-calendar me-2"></i>
                                    <strong>Posted on:</strong> @Model.CreatedDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                </li>
                                @if (Model.ExpiryDate.HasValue)
                                {
                                    <li class="mb-2">
                                        <i class="bi bi-clock me-2"></i>
                                        <strong>Expires on:</strong> @Model.ExpiryDate.Value.ToString("MMMM dd, yyyy")
                                    </li>
                                }
                                @if (isAdmin)
                                {
                                    <li class="mb-2">
                                        <i class="bi bi-eye me-2"></i>
                                        <strong>Views:</strong> @Model.ViewCount
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">
                                <i class="bi bi-people me-2"></i>Target Audience
                            </h6>
                            <div class="d-flex flex-wrap gap-2">
                                @if (Model.ForAllTenants)
                                {
                                    <span class="badge bg-info">
                                        <i class="bi bi-house-door me-1"></i>All Tenants
                                    </span>
                                }
                                @if (Model.ForAllCaretakers)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-wrench me-1"></i>All Caretakers
                                    </span>
                                }
                                @if (Model.ForAllManagers)
                                {
                                    <span class="badge bg-primary">
                                        <i class="bi bi-briefcase me-1"></i>All Managers
                                    </span>
                                }
                            </div>

                            @if (Model.TargetPropertyIds.Any())
                            {
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="bi bi-building me-1"></i>
                                        Targeted to @Model.TargetPropertyIds.Count specific propert@(Model.TargetPropertyIds.Count == 1 ? "y" : "ies")
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer with Actions -->
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>

                        @if (isAdmin)
                        {
                            <div>
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isAdmin)
{
    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this announcement? This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
