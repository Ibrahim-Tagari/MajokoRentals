@model MajokoRentals.Core.ViewModels.PropertyDetailsViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Model.Name;
}

<!-- Mapbox CSS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css' rel='stylesheet' />

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
    @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
    }
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Image Gallery -->
        @if (Model.Images.Any())
        {
            <div id="propertyCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        <button type="button" data-bs-target="#propertyCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
                    }
                </div>
                <div class="carousel-inner rounded shadow">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Images[i]" class="d-block w-100" alt="Property Image" style="height: 400px; object-fit: cover;">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        }
        else
        {
            <div class="rounded shadow mb-4 d-flex align-items-center justify-content-center" style="height: 400px; background-color: var(--tertiary-bg); border: 1px solid var(--border-color);">
                <i class="bi bi-house text-muted" style="font-size: 6rem;"></i>
            </div>
        }

        <!-- Description -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="card-title mb-3">Description</h3>
                <p class="card-text">@Model.Description</p>
            </div>
        </div>

        <!-- Amenities -->
        @if (Model.Amenities.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title mb-3">Amenities</h3>
                    <div class="row g-2">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="col-md-6">
                                <i class="bi bi-check-circle text-success me-2"></i>@amenity
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Property Location Map -->
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title mb-3 text-accent">
                        <i class="bi bi-geo-alt-fill me-2"></i>Property Location
                    </h3>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Exact location of the property
                    </p>
                    <div id="propertyMap" style="height: 350px; border-radius: 0.375rem;"></div>
                    <div class="mt-3 text-muted small">
                        <i class="bi bi-pin-map me-1"></i>
                        Coordinates: @Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")
                    </div>
                </div>
            </div>
        }

        <!-- Recent Maintenance Requests -->
        @if (Model.RecentMaintenanceRequests.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-3">Recent Maintenance Requests</h3>
                    <div class="list-group">
                        @foreach (var request in Model.RecentMaintenanceRequests)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1">@request.Title</h6>
                                        <small class="text-muted">@request.ReportedDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <span class="badge bg-@(request.Status == MaintenanceStatus.Resolved ? "success" : request.Status == MaintenanceStatus.InProgress ? "warning" : "secondary")">
                                        @request.Status
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Property Info -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="card-title mb-3">@Model.Name</h3>
                <p class="text-muted">
                    <i class="bi bi-geo-alt me-1"></i>@Model.Address<br />
                    @Model.City, @Model.Province @Model.PostalCode
                </p>

                <hr />

                <div class="mb-3">
                    <h4 class="text-primary">R @Model.MonthlyRent.ToString("N2")</h4>
                    <small class="text-muted">per month</small>
                </div>

                <div class="mb-3">
                    <strong>Security Deposit:</strong> R @Model.SecurityDeposit.ToString("N2")
                </div>

                <hr />

                <div class="row text-center mb-3">
                    <div class="col-4">
                        <i class="bi bi-door-closed d-block text-primary" style="font-size: 2rem;"></i>
                        <strong>@Model.Bedrooms</strong><br />
                        <small>Bedrooms</small>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-droplet d-block text-primary" style="font-size: 2rem;"></i>
                        <strong>@Model.Bathrooms</strong><br />
                        <small>Bathrooms</small>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-rulers d-block text-primary" style="font-size: 2rem;"></i>
                        <strong>@Model.SquareMeters</strong><br />
                        <small>m²</small>
                    </div>
                </div>

                <hr />

                <div class="mb-3">
                    <strong>Status:</strong>
                    <span class="badge bg-@(Model.Status == PropertyStatus.Available ? "success" : Model.Status == PropertyStatus.Occupied ? "warning" : "secondary")">
                        @Model.Status
                    </span>
                </div>

                @if (Model.Status == PropertyStatus.Available)
                {
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        @if (!User.IsInRole("Admin") && !User.IsInRole("PropertyManager"))
                        {
                            <div class="d-grid mb-3">
                                <a asp-controller="RentalApplications" asp-action="Create" asp-route-propertyId="@Model.Id" class="btn btn-primary btn-lg">
                                    <i class="bi bi-file-earmark-plus me-2"></i>Apply Now
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3">
                            <small>
                                <i class="bi bi-info-circle me-1"></i>
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a> to apply for this property
                            </small>
                        </div>
                    }
                }

                @if (Model.ActiveLease != null)
                {
                    <div class="alert alert-info">
                        <strong>Current Tenant:</strong><br />
                        @Model.ActiveLease.Tenant.FirstName @Model.ActiveLease.Tenant.LastName<br />
                        <small>Lease ends: @Model.ActiveLease.EndDate.ToString("MMM dd, yyyy")</small>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Map -->
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-accent">
                        <i class="bi bi-geo-alt-fill me-2"></i>Location
                    </h5>
                    <div id="sidebarMap" style="height: 200px; border-radius: 0.375rem;"></div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-pin-map me-1"></i>
                        @Model.Address
                    </small>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Mapbox GL JS -->
    <script src='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js'></script>

    <script>
        $(document).ready(function() {
            @{
                var hasLatitude = Model.Latitude.HasValue;
                var hasLongitude = Model.Longitude.HasValue;
            }

            console.log('=== Property Details Page Loaded ===');
            console.log('Model.Latitude:', @(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null"));
            console.log('Model.Longitude:', @(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null"));
            console.log('HasLat:', @hasLatitude.ToString().ToLower());
            console.log('HasLng:', @hasLongitude.ToString().ToLower());

            @if (hasLatitude && hasLongitude)
            {
                @:console.log('=== Initializing Maps ===');
                @:
                @:// Initialize Mapbox
                @:mapboxgl.accessToken = '@(Configuration["Mapbox:AccessToken"])';
                @:console.log('Mapbox Access Token:', mapboxgl.accessToken ? 'Set' : 'NOT SET');
                @:
                @:const propertyLocation = [@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)];
                @:console.log('Property Location:', propertyLocation);
                @:
                @:try {
                @:    // Main property map
                @:    console.log('Creating main property map...');
                @:    const propertyMap = new mapboxgl.Map({
                @:        container: 'propertyMap',
                @:        style: 'mapbox://styles/mapbox/dark-v11',
                @:        center: propertyLocation,
                @:        zoom: 15
                @:    });
                @:    console.log('Main property map created successfully');
                @:
                @:    // Add navigation controls
                @:    propertyMap.addControl(new mapboxgl.NavigationControl(), 'top-right');
                @:
                @:    // Add marker with gold color
                @:    new mapboxgl.Marker({
                @:        color: '#BAAA49'
                @:    })
                @:    .setLngLat(propertyLocation)
                @:    .setPopup(new mapboxgl.Popup().setHTML(`
                @:        <div style="color: #151A2C; padding: 5px;">
                @:            <strong>@Model.Name</strong><br/>
                @:            <small>@Model.Address</small>
                @:        </div>
                @:    `))
                @:    .addTo(propertyMap);
                @:
                @:    // Sidebar mini map
                @:    const sidebarMap = new mapboxgl.Map({
                @:        container: 'sidebarMap',
                @:        style: 'mapbox://styles/mapbox/dark-v11',
                @:        center: propertyLocation,
                @:        zoom: 13,
                @:        interactive: false
                @:    });
                @:
                @:    // Add marker to sidebar map
                @:    new mapboxgl.Marker({
                @:        color: '#BAAA49'
                @:    })
                @:    .setLngLat(propertyLocation)
                @:    .addTo(sidebarMap);
                @:
                @:    console.log('Maps initialized successfully!');
                @:
                @:} catch (error) {
                @:    console.error('Error initializing maps:', error);
                @:    console.error('Error details:', error.message);
                @:}
            }
            else {
                @:console.log('Maps NOT initialized - coordinates missing or invalid');
            }
        });
    </script>
}
