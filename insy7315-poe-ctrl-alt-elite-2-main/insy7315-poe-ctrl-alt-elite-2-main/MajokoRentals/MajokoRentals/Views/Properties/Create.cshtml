@model MajokoRentals.Core.ViewModels.CreatePropertyViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Add Property";
}

<!-- Mapbox CSS -->
<link href='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css' rel='stylesheet' />
<link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css" type="text/css" />

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <i class="bi bi-plus-circle me-2"></i>Add New Property
                </h2>

                <form asp-action="Create" method="post" enctype="multipart/form-data" id="propertyForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Basic Information -->
                    <h4 class="mb-3">Basic Information</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PropertyStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <h4 class="mb-3">Address</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Province" class="form-label"></label>
                            <input asp-for="Province" class="form-control" value="Gauteng" />
                            <span asp-validation-for="Province" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Map Location Picker -->
                    <h4 class="mb-3 text-accent">
                        <i class="bi bi-geo-alt-fill me-2"></i>Location on Map
                    </h4>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <p class="text-muted small">
                                <i class="bi bi-info-circle me-1"></i>
                                Click on the map to set the exact location of the property, or search for an address using the search box.
                            </p>
                            <div id="map" style="height: 400px; border-radius: 0.375rem; border: 1px solid var(--border-color);"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Latitude</label>
                            <input type="text" id="latitude-display" class="form-control" readonly style="background-color: var(--tertiary-bg);" placeholder="Click on map to set location" />
                            <input type="hidden" id="latitude" name="Latitude" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Longitude</label>
                            <input type="text" id="longitude-display" class="form-control" readonly style="background-color: var(--tertiary-bg);" placeholder="Click on map to set location" />
                            <input type="hidden" id="longitude" name="Longitude" />
                        </div>
                    </div>

                    <!-- Property Details -->
                    <h4 class="mb-3">Property Details</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Bedrooms" class="form-label"></label>
                            <input asp-for="Bedrooms" class="form-control" type="number" min="1" max="10" />
                            <span asp-validation-for="Bedrooms" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Bathrooms" class="form-label"></label>
                            <input asp-for="Bathrooms" class="form-control" type="number" min="1" max="10" />
                            <span asp-validation-for="Bathrooms" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SquareMeters" class="form-label"></label>
                            <input asp-for="SquareMeters" class="form-control" type="number" min="1" />
                            <span asp-validation-for="SquareMeters" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Financial Information -->
                    <h4 class="mb-3">Financial Information</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="MonthlyRent" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SecurityDeposit" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="SecurityDeposit" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="SecurityDeposit" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Amenities -->
                    <h4 class="mb-3">Amenities</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <small class="text-muted">Select amenities available at this property</small>
                            <div class="row mt-2">
                                @{
                                    var commonAmenities = new[] { "WiFi", "Parking", "Garden", "Security", "Pool", "Air Conditioning", "Heating", "Dishwasher", "Washing Machine", "Dryer", "Fireplace", "Balcony" };
                                    foreach (var amenity in commonAmenities)
                                    {
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <input class="form-check-input amenity-checkbox" type="checkbox" value="@amenity" id="amenity_@amenity.Replace(" ", "")" />
                                                <label class="form-check-label" for="amenity_@amenity.Replace(" ", "")">
                                                    @amenity
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Image Upload -->
                    <h4 class="mb-3">Property Images</h4>
                    <div class="mb-4">
                        <label asp-for="ImageFiles" class="form-label"></label>
                        <input asp-for="ImageFiles" class="form-control" type="file" multiple accept="image/*" />
                        <small class="text-muted">You can select multiple images. Supported formats: JPG, PNG, WebP, GIF, BMP, SVG (max 10MB each)</small>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Create Property
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <!-- Mapbox GL JS -->
    <script src='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js'></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js"></script>

    <script>
        $(document).ready(function () {
            // Handle amenities checkboxes
            $('.amenity-checkbox').on('change', function () {
                var amenities = [];
                $('.amenity-checkbox:checked').each(function () {
                    amenities.push($(this).val());
                });

                // Remove existing hidden inputs
                $('input[name="Amenities"]').remove();

                // Add new hidden inputs for each selected amenity
                amenities.forEach(function (amenity, index) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'Amenities[' + index + ']',
                        value: amenity
                    }).appendTo('form');
                });
            });

            // Initialize Mapbox
            mapboxgl.accessToken = '@(Configuration["Mapbox:AccessToken"])';

            // Default center (Johannesburg, South Africa)
            const defaultCenter = [28.0473, -26.2041];

            const map = new mapboxgl.Map({
                container: 'map',
                style: 'mapbox://styles/mapbox/dark-v11', // Dark theme to match your UI
                center: defaultCenter,
                zoom: 12
            });

            // Add navigation controls
            map.addControl(new mapboxgl.NavigationControl(), 'top-right');

            // Add geocoder (search box)
            const geocoder = new MapboxGeocoder({
                accessToken: mapboxgl.accessToken,
                mapboxgl: mapboxgl,
                marker: false,
                placeholder: 'Search for address or place...',
                countries: 'za' // Limit to South Africa
            });
            map.addControl(geocoder, 'top-left');

            // Create a draggable marker
            const marker = new mapboxgl.Marker({
                draggable: true,
                color: '#BAAA49' // Gold color to match theme
            })
            .setLngLat(defaultCenter)
            .addTo(map);

            // Update coordinates when marker is dragged
            function onDragEnd() {
                const lngLat = marker.getLngLat();
                updateCoordinates(lngLat.lat, lngLat.lng);
            }

            marker.on('dragend', onDragEnd);

            // Update coordinates when clicking on map
            map.on('click', function(e) {
                marker.setLngLat(e.lngLat);
                updateCoordinates(e.lngLat.lat, e.lngLat.lng);
            });

            // Update coordinates when geocoder result is selected
            geocoder.on('result', function(e) {
                const coords = e.result.geometry.coordinates;
                marker.setLngLat(coords);
                updateCoordinates(e.result.center[1], e.result.center[0]);

                // Optionally update address field
                if (e.result.place_name) {
                    $('#Address').val(e.result.place_name);
                }
            });

            // Function to update latitude and longitude inputs
            function updateCoordinates(lat, lng) {
                $('#latitude').val(lat.toFixed(6));
                $('#longitude').val(lng.toFixed(6));
                $('#latitude-display').val(lat.toFixed(6));
                $('#longitude-display').val(lng.toFixed(6));

                // Create popup showing coordinates
                new mapboxgl.Popup()
                    .setLngLat([lng, lat])
                    .setHTML(`<strong>Property Location</strong><br/>Lat: ${lat.toFixed(6)}<br/>Lng: ${lng.toFixed(6)}`)
                    .addTo(map);
            }

            // If editing and coordinates exist, set marker position
            const existingLat = parseFloat($('#latitude').val());
            const existingLng = parseFloat($('#longitude').val());

            if (!isNaN(existingLat) && !isNaN(existingLng)) {
                marker.setLngLat([existingLng, existingLat]);
                map.setCenter([existingLng, existingLat]);
                map.setZoom(15);
            }

            // Update map when address is typed (optional - geocode on blur)
            $('#Address').on('blur', function() {
                const address = $(this).val();
                if (address) {
                    fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(address)}.json?access_token=${mapboxgl.accessToken}&country=za&limit=1`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.features && data.features.length > 0) {
                                const coords = data.features[0].center;
                                marker.setLngLat(coords);
                                map.flyTo({ center: coords, zoom: 15 });
                                updateCoordinates(coords[1], coords[0]);
                            }
                        })
                        .catch(error => console.error('Geocoding error:', error));
                }
            });
        });
    </script>
}
