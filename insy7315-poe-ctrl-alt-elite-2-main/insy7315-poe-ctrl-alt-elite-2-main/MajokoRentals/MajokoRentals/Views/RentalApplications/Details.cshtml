@model MajokoRentals.Core.ViewModels.RentalApplicationDetailsViewModel

@{
    ViewData["Title"] = "Application Details";
}

<div class="mb-4">
    @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager"))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
        @if (Model.Status == ApplicationStatus.Submitted)
        {
            <a asp-action="Review" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-clipboard-check me-1"></i>Review Application
            </a>
        }
    }
    else
    {
        <a asp-action="MyApplications" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to My Applications
        </a>
    }
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Application Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="fw-bold mb-2">Rental Application</h2>
                        <p class="text-muted mb-0">
                            <i class="bi bi-calendar me-1"></i>Submitted: @Model.ApplicationDate.ToString("MMMM dd, yyyy")
                        </p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-@(Model.Status == ApplicationStatus.Approved ? "success" : Model.Status == ApplicationStatus.Rejected ? "danger" : "warning")" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            @Model.Status
                        </span>
                    </div>
                </div>

                @if (Model.Status == ApplicationStatus.Approved)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Application Approved!</strong><br />
                        This application was approved on @Model.ReviewedDate?.ToString("MMMM dd, yyyy").
                    </div>
                }
                else if (Model.Status == ApplicationStatus.Rejected)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-x-circle me-2"></i>
                        <strong>Application Rejected</strong><br />
                        @if (!string.IsNullOrEmpty(Model.RejectionReason))
                        {
                            <p class="mb-0 mt-2">@Model.RejectionReason</p>
                        }
                    </div>
                }
                else if (Model.Status == ApplicationStatus.Submitted)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-hourglass-split me-2"></i>
                        <strong>Pending Review</strong><br />
                        This application has been pending for @Model.DaysPending days.
                    </div>
                }
            </div>
        </div>

        <!-- Property Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Property Information</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Property:</strong><br />
                        @Model.PropertyName
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Address:</strong><br />
                        @Model.PropertyAddress
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Monthly Rent:</strong><br />
                        <span class="text-primary fw-bold">R @Model.PropertyRent.ToString("N2")</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Preferred Move-in Date:</strong><br />
                        @Model.PreferredMoveInDate.ToString("MMMM dd, yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- Personal Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Personal Information</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Full Name:</strong><br />
                        @Model.FullName
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Email:</strong><br />
                        @Model.Email
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Phone:</strong><br />
                        @Model.Phone
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>ID Number:</strong><br />
                        @Model.IdNumber
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CurrentAddress))
                    {
                        <div class="col-md-12 mb-3">
                            <strong>Current Address:</strong><br />
                            @Model.CurrentAddress
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Employment Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Employment Information</h5>
                <div class="row">
                    @if (!string.IsNullOrEmpty(Model.EmploymentStatus))
                    {
                        <div class="col-md-6 mb-3">
                            <strong>Employment Status:</strong><br />
                            @Model.EmploymentStatus
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.EmployerName))
                    {
                        <div class="col-md-6 mb-3">
                            <strong>Employer:</strong><br />
                            @Model.EmployerName
                        </div>
                    }
                    @if (Model.MonthlyIncome.HasValue)
                    {
                        <div class="col-md-6 mb-3">
                            <strong>Monthly Income:</strong><br />
                            <span class="text-success fw-bold">R @Model.MonthlyIncome.Value.ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Rental Details -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Rental Details</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Number of Occupants:</strong><br />
                        @Model.NumberOfOccupants
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Pets:</strong><br />
                        @(Model.HasPets ? "Yes" : "No")
                        @if (Model.HasPets && !string.IsNullOrEmpty(Model.PetDetails))
                        {
                            <br />
                            <small class="text-muted">@Model.PetDetails</small>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AdditionalInformation))
                {
                    <hr />
                    <div class="mt-3">
                        <strong>Additional Information:</strong><br />
                        <p class="mb-0 mt-2">@Model.AdditionalInformation</p>
                    </div>
                }
            </div>
        </div>

        <!-- Supporting Documents -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Supporting Documents</h5>
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.IdDocumentUrl))
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                                <p class="mb-1 mt-2"><strong>ID Document</strong></p>
                                <a href="@Model.IdDocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-download me-1"></i>View/Download
                                </a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ProofOfIncomeUrl))
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                                <p class="mb-1 mt-2"><strong>Proof of Income</strong></p>
                                <a href="@Model.ProofOfIncomeUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-download me-1"></i>View/Download
                                </a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.BankStatementUrl))
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                                <p class="mb-1 mt-2"><strong>Bank Statement</strong></p>
                                <a href="@Model.BankStatementUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-download me-1"></i>View/Download
                                </a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ReferenceLetterUrl))
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                                <p class="mb-1 mt-2"><strong>Reference Letter</strong></p>
                                <a href="@Model.ReferenceLetterUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-download me-1"></i>View/Download
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @if (string.IsNullOrEmpty(Model.IdDocumentUrl) && string.IsNullOrEmpty(Model.ProofOfIncomeUrl) &&
                     string.IsNullOrEmpty(Model.BankStatementUrl) && string.IsNullOrEmpty(Model.ReferenceLetterUrl))
                {
                    <p class="text-muted mb-0">No documents uploaded</p>
                }
            </div>
        </div>

        <!-- Review Notes -->
        @if (!string.IsNullOrEmpty(Model.ReviewNotes))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Review Notes</h5>
                    <p class="mb-0">@Model.ReviewNotes</p>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Application Status -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Application Status</h5>
                <div class="mb-3">
                    <strong>Current Status:</strong><br />
                    <span class="badge bg-@(Model.Status == ApplicationStatus.Approved ? "success" : Model.Status == ApplicationStatus.Rejected ? "danger" : "warning") mt-1">
                        @Model.Status
                    </span>
                </div>
                <div class="mb-3">
                    <strong>Submitted:</strong><br />
                    @Model.ApplicationDate.ToString("MMMM dd, yyyy")
                </div>
                @if (Model.ReviewedDate.HasValue)
                {
                    <div class="mb-3">
                        <strong>Reviewed:</strong><br />
                        @Model.ReviewedDate.Value.ToString("MMMM dd, yyyy")
                        @if (!string.IsNullOrEmpty(Model.ReviewedBy))
                        {
                            <br />
                            <small class="text-muted">by @Model.ReviewedBy</small>
                        }
                    </div>
                }
                @if (Model.Status == ApplicationStatus.Submitted)
                {
                    <div class="mb-3">
                        <strong>Days Pending:</strong><br />
                        <span class="badge bg-@(Model.DaysPending > 7 ? "danger" : Model.DaysPending > 3 ? "warning" : "info")">
                            @Model.DaysPending days
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Quick Actions</h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-building me-1"></i>View Property
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager"))
                    {
                        @if (Model.Status == ApplicationStatus.Submitted)
                        {
                            <a asp-action="Review" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-clipboard-check me-1"></i>Review Application
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
