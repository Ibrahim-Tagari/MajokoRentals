@model IEnumerable<MajokoRentals.Core.ViewModels.RentalApplicationListViewModel>

@{
    ViewData["Title"] = "Rental Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text me-2"></i>Rental Applications</h2>
</div>

<!-- Filter and Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm" style="background-color: var(--accent-gold); color: var(--primary-bg);">
            <div class="card-body">
                <h6 class="card-title" style="color: var(--primary-bg);">Total Applications</h6>
                <h3 class="mb-0" style="color: var(--primary-bg);">@Model.Count()</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm" style="background-color: var(--accent-gold-dark); color: var(--text-primary);">
            <div class="card-body">
                <h6 class="card-title" style="color: var(--text-primary);">Pending Review</h6>
                <h3 class="mb-0" style="color: var(--text-primary);">@Model.Count(a => a.Status == ApplicationStatus.Submitted)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm" style="background-color: #17a2b8; color: var(--text-primary);">
            <div class="card-body">
                <h6 class="card-title" style="color: var(--text-primary);">Approved</h6>
                <h3 class="mb-0" style="color: var(--text-primary);">@Model.Count(a => a.Status == ApplicationStatus.Approved)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm" style="background-color: var(--secondary-bg); color: var(--text-primary); border: 2px solid var(--border-color);">
            <div class="card-body">
                <h6 class="card-title" style="color: var(--text-muted);">Rejected</h6>
                <h3 class="mb-0" style="color: var(--text-muted);">@Model.Count(a => a.Status == ApplicationStatus.Rejected)</h3>
            </div>
        </div>
    </div>
</div>

<!-- Filter Form -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Filter by Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (ApplicationStatus status in ViewBag.StatusFilter)
                    {
                        <option value="@status" selected="@(ViewBag.CurrentStatus == status)">@status</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Applications List -->
<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                <p class="text-muted mt-3">No rental applications found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover" style="color: var(--text-primary);">
                    <thead style="background-color: var(--secondary-bg); color: var(--text-primary);">
                        <tr>
                            <th style="color: var(--text-primary);">Applicant</th>
                            <th style="color: var(--text-primary);">Property</th>
                            <th style="color: var(--text-primary);">Submitted</th>
                            <th style="color: var(--text-primary);">Days Pending</th>
                            <th style="color: var(--text-primary);">Status</th>
                            <th style="color: var(--text-primary);">Reviewed By</th>
                            <th style="color: var(--text-primary);">Actions</th>
                        </tr>
                    </thead>
                    <tbody style="background-color: var(--secondary-bg);">
                        @foreach (var application in Model)
                        {
                            <tr style="background-color: var(--secondary-bg) !important;">
                                <td style="color: var(--text-primary) !important;">
                                    <strong>@application.ApplicantName</strong><br />
                                    <small class="text-muted">@application.ApplicantEmail</small>
                                </td>
                                <td style="color: var(--text-primary) !important;">
                                    <strong>@application.PropertyName</strong><br />
                                    <small class="text-muted">@application.PropertyAddress</small>
                                </td>
                                <td style="color: var(--text-primary) !important;">@application.ApplicationDate.ToString("MMM dd, yyyy")</td>
                                <td style="color: var(--text-primary) !important;">
                                    @if (application.Status == ApplicationStatus.Submitted)
                                    {
                                        <span class="badge bg-@(application.DaysPending > 7 ? "danger" : application.DaysPending > 3 ? "warning" : "info")">
                                            @application.DaysPending days
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td style="color: var(--text-primary) !important;">
                                    <span class="badge bg-@(application.Status == ApplicationStatus.Approved ? "success" : application.Status == ApplicationStatus.Rejected ? "danger" : "warning")">
                                        @application.Status
                                    </span>
                                </td>
                                <td style="color: var(--text-primary) !important;">
                                    @if (!string.IsNullOrEmpty(application.ReviewedByName))
                                    {
                                        <span>@application.ReviewedByName</span><br />
                                        <small class="text-muted">@application.ReviewedDate?.ToString("MMM dd")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td style="color: var(--text-primary) !important;">
                                    <a asp-action="Details" asp-route-id="@application.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                    @if (application.Status == ApplicationStatus.Submitted)
                                    {
                                        <a asp-action="Review" asp-route-id="@application.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-clipboard-check me-1"></i>Review
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
