@model MajokoRentals.Models.ViewModels.MyChatsViewModel

@{
    ViewData["Title"] = "My Chats";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-chat-dots"></i> My Conversations</h2>
        @if (Model.UserRole == "Tenant")
        {
            <a asp-action="RequestChat" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Chat Request
            </a>
        }
        @if (Model.UserRole == "Admin" || Model.UserRole == "PropertyManager" || Model.UserRole == "Caretaker")
        {
            <a asp-action="PendingRequests" class="btn btn-warning position-relative">
                <i class="bi bi-clock-history"></i> Pending Requests
                @if (Model.PendingSessions.Any())
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @Model.PendingSessions.Count
                    </span>
                }
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Active Chats -->
    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="bi bi-chat-fill"></i> Active Conversations
                @if (Model.TotalUnreadCount > 0)
                {
                    <span class="badge bg-danger">@Model.TotalUnreadCount unread</span>
                }
            </h5>
        </div>
        <div class="card-body">
            @if (Model.ActiveSessions.Any())
            {
                <div class="list-group">
                    @foreach (var session in Model.ActiveSessions.OrderByDescending(s => s.LastMessage != null ? s.LastMessage.SentAt : s.StartedAt ?? s.RequestedAt))
                    {
                        <a asp-action="Conversation" asp-route-id="@session.Id"
                           class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center">
                                        <h5 class="mb-1">
                                            @session.Subject
                                            @if (session.UnreadMessageCount > 0)
                                            {
                                                <span class="badge bg-primary">@session.UnreadMessageCount new</span>
                                            }
                                        </h5>
                                        @switch (session.Priority)
                                        {
                                            case MajokoRentals.Core.Models.SessionPriority.Urgent:
                                                <span class="badge bg-danger ms-2">URGENT</span>
                                                break;
                                            case MajokoRentals.Core.Models.SessionPriority.High:
                                                <span class="badge bg-warning ms-2">HIGH</span>
                                                break;
                                        }
                                    </div>
                                    <p class="mb-1 text-muted">
                                        <i class="bi bi-person"></i>
                                        With: @(string.IsNullOrEmpty(session.ParticipantName) ? (string.IsNullOrEmpty(session.InitiatorName) ? "Support" : session.InitiatorName) : session.ParticipantName)
                                    </p>
                                    @if (session.LastMessage != null)
                                    {
                                        <small class="text-muted">
                                            <i class="bi bi-chat-quote"></i>
                                            @(session.LastMessage.Content.Length > 100 ?
                                                session.LastMessage.Content.Substring(0, 100) + "..." :
                                                session.LastMessage.Content)
                                        </small>
                                    }
                                </div>
                                <small class="text-muted">
                                    @if (session.LastMessage != null)
                                    {
                                        @session.LastMessage.SentAt.ToString("MMM dd, HH:mm")
                                    }
                                    else if (session.StartedAt.HasValue)
                                    {
                                        @session.StartedAt.Value.ToString("MMM dd, HH:mm")
                                    }
                                    else
                                    {
                                        @session.RequestedAt.ToString("MMM dd, HH:mm")
                                    }
                                </small>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-dots display-1"></i>
                    <p class="mt-3">No active conversations</p>
                    @if (Model.UserRole == "Tenant")
                    {
                        <a asp-action="RequestChat" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Start a New Chat
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Pending Requests (for tenants) -->
    @if (Model.PendingSessions.Any())
    {
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="bi bi-hourglass-split"></i> Pending Approval</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    @foreach (var session in Model.PendingSessions.OrderByDescending(s => s.RequestedAt))
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <div>
                                    <h6 class="mb-1">
                                        @session.Subject
                                        @if (session.Priority == MajokoRentals.Core.Models.SessionPriority.Urgent)
                                        {
                                            <span class="badge bg-danger ms-2">URGENT</span>
                                        }
                                        else if (session.Priority == MajokoRentals.Core.Models.SessionPriority.High)
                                        {
                                            <span class="badge bg-warning ms-2">HIGH</span>
                                        }
                                    </h6>
                                    @if (!string.IsNullOrEmpty(session.Description))
                                    {
                                        <p class="mb-1 text-muted small">@session.Description</p>
                                    }
                                    <p class="mb-1 text-muted">
                                        <i class="bi bi-person"></i>
                                        @if (!string.IsNullOrEmpty(session.ParticipantName))
                                        {
                                            <text>To: @session.ParticipantName</text>
                                        }
                                        else
                                        {
                                            <text>Waiting for admin/manager to respond...</text>
                                        }
                                    </p>
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i> Requested: @session.RequestedAt.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                                <span class="badge bg-warning text-dark">Pending</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-refresh every 30 seconds to check for new messages
        setTimeout(function () {
            location.reload();
        }, 30000);
    </script>
}
