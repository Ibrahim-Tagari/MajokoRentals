@model MajokoRentals.Models.ViewModels.RequestChatViewModel

@{
    ViewData["Title"] = "Request Chat";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-chat-dots"></i> Request Chat with Staff
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="RequestChat" method="post">
                        <div class="mb-3">
                            <label asp-for="ParticipantId" class="form-label">
                                <i class="bi bi-person"></i> Send To
                            </label>
                            <select asp-for="ParticipantId" class="form-select" required>
                                <option value="">-- Select recipient --</option>
                                @foreach (var recipient in Model.AvailableRecipients)
                                {
                                    <option value="@recipient.Id">
                                        @recipient.Name (@recipient.Role) - @recipient.Email
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ParticipantId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label">
                                <i class="bi bi-exclamation-circle"></i> Priority
                            </label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Normal" selected>Normal</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                            <small class="form-text text-muted">Select "High" or "Urgent" for important matters</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label">
                                <i class="bi bi-pencil"></i> Subject
                            </label>
                            <input asp-for="Subject" class="form-control" placeholder="Brief description of your request" required maxlength="200" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InitialMessage" class="form-label">
                                <i class="bi bi-chat-text"></i> Message
                            </label>
                            <textarea asp-for="InitialMessage" class="form-control" rows="6"
                                      placeholder="Please provide details about your request..." required></textarea>
                            <span asp-validation-for="InitialMessage" class="text-danger"></span>
                        </div>

                        @if (Model.RelatedPropertyId.HasValue)
                        {
                            <input type="hidden" asp-for="RelatedPropertyId" />
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> This chat is related to property #@Model.RelatedPropertyId
                            </div>
                        }

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="MyChats" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> Send Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title"><i class="bi bi-info-circle"></i> What happens next?</h6>
                        <ol class="mb-0">
                            <li>Your chat request will be sent to the selected staff member</li>
                            <li>They will review and approve your request</li>
                            <li>You'll receive a notification when approved</li>
                            <li>You can then start chatting in real-time</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
