@model MajokoRentals.Core.ViewModels.RecordPaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <i class="bi bi-cash me-2"></i>Record Payment
                </h2>

                <div class="alert alert-info mb-4">
                    <strong>Invoice:</strong> @Model.InvoiceNumber<br />
                    <strong>Total Amount:</strong> R @Model.InvoiceAmount.ToString("N2")<br />
                    <strong>Already Paid:</strong> R @Model.AmountAlreadyPaid.ToString("N2")<br />
                    <strong>Amount Due:</strong> R @Model.AmountDue.ToString("N2")
                </div>

                <form asp-action="RecordPayment" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="InvoiceId" />
                    <input type="hidden" asp-for="InvoiceNumber" />
                    <input type="hidden" asp-for="InvoiceAmount" />
                    <input type="hidden" asp-for="AmountAlreadyPaid" />
                    <input type="hidden" asp-for="AmountDue" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                            <small class="text-muted">Maximum: R @Model.AmountDue.ToString("N2")</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="form-label"></label>
                            <input asp-for="PaymentDate" class="form-control" type="date" />
                            <span asp-validation-for="PaymentDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="Cash">Cash</option>
                                <option value="Bank Transfer" selected>Bank Transfer</option>
                                <option value="EFT">EFT</option>
                                <option value="Credit Card">Credit Card</option>
                                <option value="Debit Card">Debit Card</option>
                                <option value="Check">Check</option>
                                <option value="Mobile Payment">Mobile Payment</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TransactionReference" class="form-label"></label>
                            <input asp-for="TransactionReference" class="form-control" />
                            <span asp-validation-for="TransactionReference" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentProof" class="form-label"></label>
                        <input asp-for="PaymentProof" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                        <small class="text-muted">Upload proof of payment (receipt, bank statement, etc.)</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                        <a asp-action="InvoiceDetails" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="InvoiceDetails" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-cash me-1"></i>Record Payment
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Set maximum payment amount
        $(document).ready(function() {
            var maxAmount = @Model.AmountDue;
            $('#Amount').attr('max', maxAmount);

            $('#Amount').on('input', function() {
                var value = parseFloat($(this).val());
                if (value > maxAmount) {
                    $(this).val(maxAmount);
                    alert('Payment amount cannot exceed R ' + maxAmount.toFixed(2));
                }
            });
        });
    </script>
}
