@model MajokoRentals.Core.ViewModels.InvoiceDetailsViewModel

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="mb-4">
    @if (User.IsInRole("Admin") || User.IsInRole("PropertyManager"))
    {
        <a asp-action="Invoices" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    }
    else
    {
        <a asp-action="MyInvoices" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to My Invoices
        </a>
    }
    @if (Model.Status != PaymentStatus.Paid)
    {
        @if (User.IsInRole("Tenant"))
        {
            <a asp-action="PaymentGateway" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bi bi-credit-card me-1"></i>Pay Now
            </a>
        }
        else
        {
            <a asp-action="RecordPayment" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bi bi-cash me-1"></i>Record Payment
            </a>
        }
    }
</div>

<!-- Status Alerts -->
@if (Model.IsOverdue)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Invoice Overdue!</strong> This invoice is @Model.DaysOverdue days overdue. Payment is required immediately.
    </div>
}
else if (Model.Status == PaymentStatus.Paid)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        <strong>Invoice Paid!</strong> This invoice was paid on @Model.PaidDate?.ToString("MMM dd, yyyy").
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <!-- Invoice Details Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h2 class="fw-bold mb-0">INVOICE</h2>
                        <p class="text-muted mb-0">@Model.InvoiceNumber</p>
                    </div>
                    <span class="badge bg-@(Model.Status == PaymentStatus.Paid ? "success" : Model.Status == PaymentStatus.Overdue ? "danger" : Model.Status == PaymentStatus.PartiallyPaid ? "warning" : "secondary")" style="font-size: 1rem; padding: 0.5rem 1rem;">
                        @Model.Status
                    </span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-2">BILL TO:</h6>
                        <strong>@Model.TenantName</strong><br />
                        @Model.TenantEmail
                    </div>
                    <div class="col-md-6 text-md-end">
                        <h6 class="text-muted mb-2">PROPERTY:</h6>
                        <strong>@Model.PropertyName</strong><br />
                        @Model.PropertyAddress
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <strong>Invoice Date:</strong><br />
                        @Model.InvoiceDate.ToString("MMM dd, yyyy")
                    </div>
                    <div class="col-md-4">
                        <strong>Due Date:</strong><br />
                        <span class="@(Model.IsOverdue ? "text-danger fw-bold" : "")">
                            @Model.DueDate.ToString("MMM dd, yyyy")
                        </span>
                    </div>
                    @if (Model.PaidDate.HasValue)
                    {
                        <div class="col-md-4">
                            <strong>Paid Date:</strong><br />
                            <span class="text-success">@Model.PaidDate.Value.ToString("MMM dd, yyyy")</span>
                        </div>
                    }
                </div>

                <hr />

                <div class="table-responsive mb-4">
                    <table class="table">
                        <thead class="table-light">
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@(Model.Description ?? "Monthly Rent")</td>
                                <td class="text-end">R @Model.Amount.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Total Amount:</strong></td>
                                <td class="text-end"><strong>R @Model.Amount.ToString("N2")</strong></td>
                            </tr>
                            <tr class="text-success">
                                <td><strong>Amount Paid:</strong></td>
                                <td class="text-end"><strong>R @Model.AmountPaid.ToString("N2")</strong></td>
                            </tr>
                            <tr class="@(Model.AmountDue > 0 ? "text-warning" : "text-success")">
                                <td><strong>Amount Due:</strong></td>
                                <td class="text-end">
                                    <h4 class="mb-0"><strong>R @Model.AmountDue.ToString("N2")</strong></h4>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="alert alert-info">
                        <strong>Notes:</strong> @Model.Notes
                    </div>
                }
            </div>
        </div>

        <!-- Payment History -->
        @if (Model.Payments.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-3">Payment History</h4>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th>Proof</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-success">R @payment.Amount.ToString("N2")</td>
                                        <td>@payment.PaymentMethod</td>
                                        <td>@(payment.ReferenceNumber ?? "N/A")</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(payment.ProofOfPaymentUrl))
                                            {
                                                <a href="@payment.ProofOfPaymentUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-file-earmark"></i> View
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Quick Actions</h5>
                <div class="d-grid gap-2">
                    @if (Model.Status != PaymentStatus.Paid)
                    {
                        <a asp-action="RecordPayment" asp-route-id="@Model.Id" class="btn btn-success">
                            <i class="bi bi-cash me-2"></i>Record Payment
                        </a>
                    }
                    <button class="btn btn-outline-primary" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i>Print Invoice
                    </button>
                    <a asp-controller="Leases" asp-action="Details" asp-route-id="@Model.LeaseId" class="btn btn-outline-secondary">
                        <i class="bi bi-file-text me-2"></i>View Lease
                    </a>
                </div>
            </div>
        </div>

        <!-- Payment Status -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Payment Status</h5>
                @if (Model.Status == PaymentStatus.Paid)
                {
                    <div class="text-center py-3">
                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                        <h4 class="text-success mt-2">Paid in Full</h4>
                        <p class="text-muted">Paid on @Model.PaidDate?.ToString("MMM dd, yyyy")</p>
                    </div>
                }
                else
                {
                    <div class="progress mb-3" style="height: 25px;">
                        @{
                            var progress = Model.Amount > 0 ? (Model.AmountPaid / Model.Amount) * 100 : 0;
                        }
                        <div class="progress-bar bg-@(progress >= 100 ? "success" : progress > 0 ? "warning" : "danger")"
                             role="progressbar"
                             style="width: @progress%"
                             aria-valuenow="@progress"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            @((int)progress)%
                        </div>
                    </div>
                    @if (Model.IsOverdue)
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>@Model.DaysOverdue days overdue</strong>
                        </div>
                    }
                    else
                    {
                        var daysUntilDue = (Model.DueDate - DateTime.Today).Days;
                        <p class="text-muted mb-0">
                            @daysUntilDue days until due date
                        </p>
                    }
                }
            </div>
        </div>
    </div>
</div>
