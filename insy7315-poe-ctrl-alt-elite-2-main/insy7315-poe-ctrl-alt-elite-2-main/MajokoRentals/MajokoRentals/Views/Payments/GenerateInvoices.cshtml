@model MajokoRentals.Core.ViewModels.GenerateInvoicesViewModel

@{
    ViewData["Title"] = "Generate Invoices";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <i class="bi bi-receipt me-2"></i>Generate Invoices
                </h2>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    This will generate rent invoices for all active leases. Invoices will be sent to tenants via email.
                </div>

                <form asp-action="GenerateInvoices" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-4">
                        <label asp-for="BillingMonth" class="form-label"></label>
                        <input asp-for="BillingMonth" class="form-control" type="month" />
                        <span asp-validation-for="BillingMonth" class="text-danger"></span>
                        <small class="text-muted">Select the month for which to generate invoices</small>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="InvoiceDate" class="form-label"></label>
                            <input asp-for="InvoiceDate" class="form-control" type="date" />
                            <span asp-validation-for="InvoiceDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" class="form-control" type="date" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="ActiveLeasesOnly" class="form-check-input" type="checkbox" />
                            <label asp-for="ActiveLeasesOnly" class="form-check-label"></label>
                        </div>
                        <small class="text-muted">Only generate invoices for leases with "Active" status</small>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> The system will skip leases that already have an invoice for the selected billing month.
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Invoices" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Generate Invoices
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // When invoice date changes, update due date to 7 days later
        $('#InvoiceDate').on('change', function() {
            var invoiceDate = new Date($(this).val());
            if (invoiceDate) {
                invoiceDate.setDate(invoiceDate.getDate() + 7);
                var dueDate = invoiceDate.toISOString().split('T')[0];
                $('#DueDate').val(dueDate);
            }
        });
    </script>
}
