@model MajokoRentals.Core.ViewModels.AdminCreateUserViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Create User Account";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="mb-4">
                    <h2 class="fw-bold text-accent">
                        <i class="bi bi-person-plus-fill me-2"></i>Create User Account
                    </h2>
                    <p class="text-muted">Create a new user account for the system</p>
                </div>

                <div id="errorMessage" class="alert alert-danger" style="display:none;"></div>
                <div id="successMessage" class="alert alert-success" style="display:none;"></div>

                <form id="createUserForm" asp-action="CreateUser" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" id="firebaseIdToken" asp-for="FirebaseIdToken" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" id="firstNameInput" class="form-control" placeholder="John" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" id="lastNameInput" class="form-control" placeholder="Doe" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" id="emailInput" class="form-control" placeholder="john.doe@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number (Optional)</label>
                            <input asp-for="PhoneNumber" id="phoneInput" class="form-control" placeholder="+27 12 345 6789" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="Minimum 6 characters" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <small class="text-muted">Password must be at least 6 characters long.</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label">User Role</label>
                            <select asp-for="Role" id="roleInput" class="form-select">
                                <option value="Tenant">Tenant - Renting a property</option>
                                <option value="Applicant">Applicant - Applying for a property</option>
                                <option value="PropertyManager">Property Manager - Manage properties</option>
                                <option value="Caretaker">Caretaker - Maintenance staff</option>
                                <option value="Admin">Admin - Full system access</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="SendWelcomeEmail" class="form-check-input" id="sendEmailCheck" />
                            <label asp-for="SendWelcomeEmail" class="form-check-label">
                                Send welcome email with login credentials
                            </label>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                        <a asp-action="Index" asp-controller="Dashboard" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                        <button type="submit" id="createUserButton" class="btn btn-primary btn-lg px-5">
                            <span id="createUserButtonText"><i class="bi bi-person-plus me-2"></i>Create User</span>
                            <span id="createUserSpinner" class="spinner-border spinner-border-sm me-2" style="display:none;"></span>
                            <span id="createUserLoadingText" style="display:none;">Creating account...</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h6 class="text-accent mb-2"><i class="bi bi-info-circle me-2"></i>Role Descriptions</h6>
                <ul class="small text-muted mb-0">
                    <li><strong>Tenant:</strong> Can view their lease, pay invoices, submit maintenance requests</li>
                    <li><strong>Applicant:</strong> Can browse properties and submit rental applications</li>
                    <li><strong>Property Manager:</strong> Can manage properties, leases, applications, and invoices</li>
                    <li><strong>Caretaker:</strong> Can view and manage maintenance requests</li>
                    <li><strong>Admin:</strong> Full system access including user management</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>

    <script>
        // Initialize Firebase
        const firebaseConfig = {
            apiKey: "@(Configuration["Firebase:ApiKey"])",
            authDomain: "@(Configuration["Firebase:AuthDomain"])",
            projectId: "@(Configuration["Firebase:ProjectId"])",
            storageBucket: "@(Configuration["Firebase:StorageBucket"])",
            messagingSenderId: "@(Configuration["Firebase:MessagingSenderId"])",
            appId: "@(Configuration["Firebase:AppId"])"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();

        // Password visibility toggle
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('togglePasswordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        });

        // Handle create user form submission
        document.getElementById('createUserForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const firstName = document.getElementById('firstNameInput').value.trim();
            const lastName = document.getElementById('lastNameInput').value.trim();
            const email = document.getElementById('emailInput').value.trim();
            const password = document.getElementById('passwordInput').value;
            const role = document.getElementById('roleInput').value;
            const errorDiv = document.getElementById('errorMessage');
            const successDiv = document.getElementById('successMessage');
            const createUserButton = document.getElementById('createUserButton');
            const createUserButtonText = document.getElementById('createUserButtonText');
            const createUserSpinner = document.getElementById('createUserSpinner');
            const createUserLoadingText = document.getElementById('createUserLoadingText');

            // Hide messages
            errorDiv.style.display = 'none';
            successDiv.style.display = 'none';

            // Client-side validation
            if (!firstName || !lastName || !email || !password || !role) {
                errorDiv.textContent = 'Please fill in all required fields.';
                errorDiv.style.display = 'block';
                return;
            }

            if (password.length < 6) {
                errorDiv.textContent = 'Password must be at least 6 characters long.';
                errorDiv.style.display = 'block';
                return;
            }

            // Show loading state
            createUserButton.disabled = true;
            createUserButtonText.style.display = 'none';
            createUserSpinner.style.display = 'inline-block';
            createUserLoadingText.style.display = 'inline';

            try {
                // Get current admin's auth state
                const currentUser = auth.currentUser;
                if (!currentUser) {
                    throw new Error('Admin must be logged in');
                }

                // Get admin's ID token to authenticate with backend
                const adminToken = await currentUser.getIdToken();

                // Create user via Firebase Admin SDK through backend
                // We'll send a request to the server which will use Firebase Admin SDK
                const response = await fetch('/Account/CreateUserViaAdmin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${adminToken}`
                    },
                    body: JSON.stringify({
                        firstName: firstName,
                        lastName: lastName,
                        email: email,
                        password: password,
                        phoneNumber: document.getElementById('phoneInput').value.trim() || null,
                        role: role,
                        sendWelcomeEmail: document.getElementById('sendEmailCheck').checked
                    })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // Show success message
                    successDiv.innerHTML = `<i class="bi bi-check-circle me-2"></i>${result.message || 'User account created successfully!'}`;
                    successDiv.style.display = 'block';

                    // Clear form
                    document.getElementById('createUserForm').reset();

                    // Scroll to top to see success message
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    throw new Error(result.message || 'Failed to create user account');
                }

                // Reset button state
                createUserButton.disabled = false;
                createUserButtonText.style.display = 'inline';
                createUserSpinner.style.display = 'none';
                createUserLoadingText.style.display = 'none';

            } catch (error) {
                console.error('User creation error:', error);

                // Show error message
                errorDiv.innerHTML = `<i class="bi bi-exclamation-circle me-2"></i>${error.message || 'An error occurred while creating the user account. Please try again.'}`;
                errorDiv.style.display = 'block';

                // Reset button state
                createUserButton.disabled = false;
                createUserButtonText.style.display = 'inline';
                createUserSpinner.style.display = 'none';
                createUserLoadingText.style.display = 'none';

                // Scroll to top to see error message
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });
    </script>
}
