@page "/account/register"
@inject IFirebaseClientAuthService FirebaseAuthService
@inject IAuthenticationService AuthService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IApiClientService ApiClient
@inject NavigationManager Navigation

<PageTitle>Register - Dr Majoko Projects</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-accent">Create Account</h2>
                    <p class="text-muted">Join Dr Majoko Projects</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="firstName" class="form-label">First Name</label>
                            <InputText id="firstName" @bind-Value="registerModel.FirstName" class="form-control" placeholder="John" />
                            <ValidationMessage For="@(() => registerModel.FirstName)" class="text-danger" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="lastName" class="form-label">Last Name</label>
                            <InputText id="lastName" @bind-Value="registerModel.LastName" class="form-control" placeholder="Doe" />
                            <ValidationMessage For="@(() => registerModel.LastName)" class="text-danger" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <InputText id="email" @bind-Value="registerModel.Email" class="form-control" placeholder="john.doe@example.com" />
                        <ValidationMessage For="@(() => registerModel.Email)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone Number (Optional)</label>
                        <InputText id="phone" @bind-Value="registerModel.PhoneNumber" class="form-control" placeholder="+27 12 345 6789" />
                        <ValidationMessage For="@(() => registerModel.PhoneNumber)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <InputText id="password" @bind-Value="registerModel.Password" type="@passwordInputType" class="form-control" placeholder="Minimum 6 characters" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="TogglePasswordVisibility">
                                <i class="bi @passwordIcon"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.Password)" class="text-danger" />
                        <small class="text-muted">Password must be at least 6 characters long.</small>
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-group">
                            <InputText id="confirmPassword" @bind-Value="registerModel.ConfirmPassword" type="@confirmPasswordInputType" class="form-control" placeholder="Re-enter password" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ToggleConfirmPasswordVisibility">
                                <i class="bi @confirmPasswordIcon"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label">I want to register as</label>
                        <InputSelect id="role" @bind-Value="registerModel.Role" class="form-select">
                            <option value="Tenant">Tenant - Looking for a property to rent</option>
                            <option value="Applicant">Applicant - Applying for a property</option>
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Creating account...</span>
                        }
                        else
                        {
                            <i class="bi bi-person-plus me-2"></i>
                            <span>Create Account</span>
                        }
                    </button>

                    <div class="position-relative my-4">
                        <hr />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted">
                            OR
                        </span>
                    </div>

                    <button type="button" class="btn btn-outline-danger btn-lg w-100 mb-3" @onclick="HandleGoogleSignIn" disabled="@isLoading">
                        <i class="bi bi-google me-2"></i>
                        <span>Sign up with Google</span>
                    </button>

                    <div class="text-center mt-3">
                        <p class="text-muted">
                            Already have an account?
                            <a href="/account/login" class="text-accent fw-bold">Sign in</a>
                        </p>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterViewModel registerModel = new();
    private string? errorMessage;
    private bool isLoading = false;
    private string passwordInputType = "password";
    private string passwordIcon = "bi-eye";
    private string confirmPasswordInputType = "password";
    private string confirmPasswordIcon = "bi-eye";

    private void TogglePasswordVisibility()
    {
        if (passwordInputType == "password")
        {
            passwordInputType = "text";
            passwordIcon = "bi-eye-slash";
        }
        else
        {
            passwordInputType = "password";
            passwordIcon = "bi-eye";
        }
    }

    private void ToggleConfirmPasswordVisibility()
    {
        if (confirmPasswordInputType == "password")
        {
            confirmPasswordInputType = "text";
            confirmPasswordIcon = "bi-eye-slash";
        }
        else
        {
            confirmPasswordInputType = "password";
            confirmPasswordIcon = "bi-eye";
        }
    }

    private async Task HandleRegister()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Client-side validation
            if (string.IsNullOrWhiteSpace(registerModel.FirstName) ||
                string.IsNullOrWhiteSpace(registerModel.LastName) ||
                string.IsNullOrWhiteSpace(registerModel.Email) ||
                string.IsNullOrWhiteSpace(registerModel.Password))
            {
                errorMessage = "Please fill in all required fields.";
                isLoading = false;
                return;
            }

            if (registerModel.Password != registerModel.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                isLoading = false;
                return;
            }

            if (registerModel.Password.Length < 6)
            {
                errorMessage = "Password must be at least 6 characters long.";
                isLoading = false;
                return;
            }

            // Step 1: Create Firebase Authentication user
            var firebaseToken = await FirebaseAuthService.CreateUserWithEmailAndPasswordAsync(
                registerModel.Email,
                registerModel.Password
            );

            if (string.IsNullOrEmpty(firebaseToken))
            {
                errorMessage = "Failed to create user account. Please try again.";
                isLoading = false;
                return;
            }

            // Step 2: Parse the token to get the UID
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(firebaseToken);
            var uid = jwtToken.Claims.FirstOrDefault(c => c.Type == "user_id")?.Value;

            if (string.IsNullOrEmpty(uid))
            {
                errorMessage = "Failed to retrieve user ID. Please try logging in.";
                isLoading = false;
                return;
            }

            // Step 3: Store token first so API calls are authenticated
            await AuthService.SetTokenAsync(firebaseToken);

            // Step 4: Notify authentication state provider
            AuthStateProvider.NotifyUserAuthentication(firebaseToken);

            // Step 5: Create user profile via API
            try
            {
                var profileData = new
                {
                    email = registerModel.Email,
                    firstName = registerModel.FirstName,
                    lastName = registerModel.LastName,
                    phoneNumber = registerModel.PhoneNumber,
                    role = registerModel.Role
                };

                await ApiClient.PostAsync<object, object>("/api/users/profile", profileData);
            }
            catch (Exception profileEx)
            {
                // Log but don't block registration - profile may already exist
                Console.WriteLine($"Profile creation note: {profileEx.Message}");
            }

            // Step 6: Navigate to dashboard
            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyErrorMessage(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetFriendlyErrorMessage(string errorMessage)
    {
        if (errorMessage.Contains("EMAIL_EXISTS") || errorMessage.Contains("email-already-in-use"))
        {
            return "An account with this email already exists.";
        }
        else if (errorMessage.Contains("INVALID_EMAIL") || errorMessage.Contains("invalid-email"))
        {
            return "Invalid email address.";
        }
        else if (errorMessage.Contains("WEAK_PASSWORD") || errorMessage.Contains("weak-password"))
        {
            return "Password is too weak. Please use a stronger password.";
        }
        else if (errorMessage.Contains("NETWORK_ERROR"))
        {
            return "Network error. Please check your internet connection.";
        }
        else if (errorMessage.Contains("TOO_MANY_ATTEMPTS"))
        {
            return "Too many attempts. Please try again later.";
        }

        return "An error occurred during registration. Please try again.";
    }

    private string GetErrorMessage(string? errorCode)
    {
        return errorCode switch
        {
            "auth/email-already-in-use" => "An account with this email already exists.",
            "auth/invalid-email" => "Invalid email address.",
            "auth/operation-not-allowed" => "Email/password accounts are not enabled.",
            "auth/weak-password" => "Password is too weak. Please use a stronger password.",
            _ => "An error occurred during registration. Please try again."
        };
    }

    private async Task HandleGoogleSignIn()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var (idToken, email, displayName, isNewUser) = await FirebaseAuthService.SignInWithGoogleAsync();

            if (!string.IsNullOrEmpty(idToken))
            {
                // Store token first so API calls are authenticated
                await AuthService.SetTokenAsync(idToken);

                // Notify authentication state provider
                AuthStateProvider.NotifyUserAuthentication(idToken);

                // Create tenant profile via API (works for both new and existing users)
                try
                {
                    var nameParts = displayName.Split(' ', 2);
                    var firstName = nameParts.Length > 0 ? nameParts[0] : "User";
                    var lastName = nameParts.Length > 1 ? nameParts[1] : "";

                    var profileData = new
                    {
                        email = email,
                        firstName = firstName,
                        lastName = lastName,
                        phoneNumber = (string?)null,
                        role = "Tenant"
                    };

                    await ApiClient.PostAsync<object, object>("/api/users/profile", profileData);
                }
                catch (Exception profileEx)
                {
                    // Log but don't block sign-up - profile may already exist
                    Console.WriteLine($"Profile creation note: {profileEx.Message}");
                }

                // Navigate to properties list (new tenants don't have a lease for the dashboard yet)
                Navigation.NavigateTo("/properties", forceLoad: true);
            }
            else
            {
                errorMessage = "Google sign-up failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Google sign-up error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class RegisterViewModel
    {
        [Required(ErrorMessage = "First name is required")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Last name is required")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";

        [Required(ErrorMessage = "Please select a role")]
        public string Role { get; set; } = "Tenant";
    }
}
