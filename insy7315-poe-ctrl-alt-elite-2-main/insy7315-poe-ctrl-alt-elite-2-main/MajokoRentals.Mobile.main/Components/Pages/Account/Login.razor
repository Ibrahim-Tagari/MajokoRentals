@page "/account/login"
@using MajokoRentals.Core.Services
@using MajokoRentals.Core.Models
@inject IFirebaseClientAuthService FirebaseAuthService
@inject IAuthenticationService AuthService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IApiClientService ApiClient
@inject NavigationManager Navigation

<PageTitle>Login - Dr Majoko Projects</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-accent">Welcome Back</h2>
                    <p class="text-muted">Sign in to your account</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <InputText id="email" @bind-Value="loginModel.Email" class="form-control form-control-lg" placeholder="Enter your email" />
                        <ValidationMessage For="@(() => loginModel.Email)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group">
                            <InputText id="password" @bind-Value="loginModel.Password" type="@passwordInputType" class="form-control form-control-lg" placeholder="Enter your password" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="TogglePasswordVisibility">
                                <i class="bi @passwordIcon"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox id="rememberMe" @bind-Value="loginModel.RememberMe" class="form-check-input" />
                        <label for="rememberMe" class="form-check-label">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-3" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            <span>Sign In</span>
                        }
                    </button>

                    <div class="position-relative my-4">
                        <hr />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted">
                            OR
                        </span>
                    </div>

                    <button type="button" class="btn btn-outline-danger btn-lg w-100 mb-3" @onclick="HandleGoogleSignIn" disabled="@isLoading">
                        <i class="bi bi-google me-2"></i>
                        <span>Continue with Google</span>
                    </button>

                    <div class="text-center mt-3">
                        <p class="text-muted">
                            Don't have an account?
                            <a href="/account/register" class="text-accent fw-bold">Register here</a>
                        </p>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="text-center mt-3 text-muted">
            <small>Demo Admin: admin@majoko.co.za | Admin@123</small>
        </div>
    </div>
</div>

@code {
    private LoginViewModel loginModel = new();
    private string? errorMessage;
    private bool isLoading = false;
    private string passwordInputType = "password";
    private string passwordIcon = "bi-eye";

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private void TogglePasswordVisibility()
    {
        if (passwordInputType == "password")
        {
            passwordInputType = "text";
            passwordIcon = "bi-eye-slash";
        }
        else
        {
            passwordInputType = "password";
            passwordIcon = "bi-eye";
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            // Use Firebase Authentication directly (like the web app does)
            var firebaseToken = await FirebaseAuthService.SignInWithEmailAndPasswordAsync(
                loginModel.Email,
                loginModel.Password
            );

            if (!string.IsNullOrEmpty(firebaseToken))
            {
                // Store token securely using SecureStorage
                await AuthService.SetTokenAsync(firebaseToken);

                // Notify authentication state provider
                AuthStateProvider.NotifyUserAuthentication(firebaseToken);

                // Navigate to return URL or dashboard
                var redirectUrl = string.IsNullOrEmpty(ReturnUrl) ? "/dashboard" : ReturnUrl;
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyErrorMessage(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetFriendlyErrorMessage(string errorMessage)
    {
        if (errorMessage.Contains("INVALID_LOGIN_CREDENTIALS") ||
            errorMessage.Contains("INVALID_PASSWORD") ||
            errorMessage.Contains("EMAIL_NOT_FOUND"))
        {
            return "Invalid email or password.";
        }
        else if (errorMessage.Contains("USER_DISABLED"))
        {
            return "This account has been disabled.";
        }
        else if (errorMessage.Contains("TOO_MANY_ATTEMPTS"))
        {
            return "Too many failed login attempts. Please try again later.";
        }
        else if (errorMessage.Contains("NETWORK_ERROR"))
        {
            return "Network error. Please check your internet connection.";
        }

        return "An error occurred during login. Please try again.";
    }

    private string GetErrorMessage(string? errorCode)
    {
        return errorCode switch
        {
            "auth/invalid-email" => "Invalid email address.",
            "auth/user-disabled" => "This account has been disabled.",
            "auth/user-not-found" => "No account found with this email.",
            "auth/wrong-password" => "Incorrect password.",
            "auth/invalid-credential" => "Invalid email or password.",
            "auth/too-many-requests" => "Too many failed login attempts. Please try again later.",
            _ => "An error occurred during login. Please try again."
        };
    }

    private async Task HandleGoogleSignIn()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var (idToken, email, displayName, isNewUser) = await FirebaseAuthService.SignInWithGoogleAsync();

            if (!string.IsNullOrEmpty(idToken))
            {
                // Store token first so API calls are authenticated
                await AuthService.SetTokenAsync(idToken);

                // Notify authentication state provider
                AuthStateProvider.NotifyUserAuthentication(idToken);

                // Create tenant profile via API (works for both new and existing users)
                try
                {
                    var nameParts = displayName.Split(' ', 2);
                    var firstName = nameParts.Length > 0 ? nameParts[0] : "User";
                    var lastName = nameParts.Length > 1 ? nameParts[1] : "";

                    var profileData = new
                    {
                        email = email,
                        firstName = firstName,
                        lastName = lastName,
                        phoneNumber = (string?)null,
                        role = "Tenant"
                    };

                    await ApiClient.PostAsync<object, object>("/api/users/profile", profileData);
                }
                catch (Exception profileEx)
                {
                    // Log but don't block login - profile may already exist
                    Console.WriteLine($"Profile creation note: {profileEx.Message}");
                }

                // Navigate to properties list (avoids auth issues with new accounts)
                var redirectUrl = string.IsNullOrEmpty(ReturnUrl) ? "/properties" : ReturnUrl;
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                errorMessage = "Google sign-in failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Google sign-in error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginViewModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
