@page "/leases"
@using MajokoRentals.Core.DTOs
@using MajokoRentals.Core.Models
@using MajokoRentals.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin,PropertyManager")]
@inject IApiClientService ApiClient
@inject NavigationManager Navigation

<PageTitle>Leases - Dr Majoko Projects</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
        <i class="bi bi-file-earmark-text me-2"></i>Leases
    </h2>
    <a href="/leases/create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Create Lease
    </a>
</div>

<!-- Filter -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-8">
                <select @bind="selectedStatus" @bind:event="onchange" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="0">Draft</option>
                    <option value="1">Active</option>
                    <option value="2">Expired</option>
                    <option value="3">Terminated</option>
                </select>
            </div>
            <div class="col-4">
                <button type="button" @onclick="LoadLeases" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading leases...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
    </div>
}
else if (leases == null || !filteredLeases.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No leases found.
        <a href="/leases/create">Create your first lease</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var lease in filteredLeases)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-1">@lease.PropertyName</h5>
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>@lease.PropertyAddress
                                </p>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-person me-1"></i>@lease.TenantName
                                </p>
                            </div>
                            <span class="badge bg-@GetStatusBadgeClass(lease.Status)">
                                @lease.Status
                            </span>
                        </div>

                        <hr />

                        <div class="row g-2 small">
                            <div class="col-6">
                                <strong>Start Date:</strong><br />
                                @lease.StartDate.ToString("dd MMM yyyy")
                            </div>
                            <div class="col-6">
                                <strong>End Date:</strong><br />
                                @lease.EndDate.ToString("dd MMM yyyy")
                            </div>
                            <div class="col-6">
                                <strong>Monthly Rent:</strong><br />
                                R @lease.MonthlyRent.ToString("N2")
                            </div>
                            <div class="col-6">
                                <strong>Security Deposit:</strong><br />
                                R @lease.SecurityDeposit.ToString("N2")
                            </div>
                        </div>

                        <div class="mt-3">
                            <a href="/leases/details/@lease.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<LeaseDto>? leases;
    private List<LeaseDto> filteredLeases => FilterLeases();
    private string selectedStatus = "";
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeases();
    }

    private async Task LoadLeases()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            leases = await ApiClient.GetAsync<List<LeaseDto>>("/api/leases");
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the server. Please check your internet connection.";
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while loading leases: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<LeaseDto> FilterLeases()
    {
        if (leases == null)
            return new List<LeaseDto>();

        var filtered = leases.AsEnumerable();

        // Apply status filter
        if (!string.IsNullOrWhiteSpace(selectedStatus) && int.TryParse(selectedStatus, out int statusValue))
        {
            filtered = filtered.Where(l => (int)l.Status == statusValue);
        }

        return filtered.OrderByDescending(l => l.StartDate).ToList();
    }

    private string GetStatusBadgeClass(LeaseStatus status)
    {
        return status switch
        {
            LeaseStatus.Draft => "secondary",
            LeaseStatus.Active => "success",
            LeaseStatus.Expired => "warning",
            LeaseStatus.Terminated => "danger",
            _ => "secondary"
        };
    }
}
