@page "/applications"
@using MajokoRentals.Core.DTOs
@using MajokoRentals.Core.Models
@using MajokoRentals.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin,PropertyManager")]
@inject IApiClientService ApiClient
@inject NavigationManager Navigation

<PageTitle>Rental Applications - Dr Majoko Projects</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
        <i class="bi bi-file-earmark-person me-2"></i>Applications
    </h2>
</div>

<!-- Filter -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <select @bind="selectedStatus" @bind:event="onchange" class="form-select">
            <option value="">All Statuses</option>
            <option value="0">Submitted</option>
            <option value="1">Under Review</option>
            <option value="2">Approved</option>
            <option value="3">Rejected</option>
            <option value="4">Withdrawn</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Loading applications...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
    </div>
}
else if (applications == null || !filteredApplications.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No applications found.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var app in filteredApplications)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title mb-1">@app.ApplicantName</h5>
                                <p class="text-muted small mb-1"><i class="bi bi-building me-1"></i>@app.PropertyName</p>
                                <p class="text-muted small mb-0"><i class="bi bi-envelope me-1"></i>@app.ApplicantEmail</p>
                            </div>
                            <span class="badge bg-@GetStatusBadgeClass(app.Status)">@app.Status</span>
                        </div>
                        <p class="small"><i class="bi bi-calendar me-1"></i>Applied: @app.ApplicationDate.ToString("dd MMM yyyy")</p>
                        <div class="mt-3">
                            <a href="/applications/details/@app.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<RentalApplicationDto>? applications;
    private List<RentalApplicationDto> filteredApplications => FilterApplications();
    private string selectedStatus = "";
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            applications = await ApiClient.GetAsync<List<RentalApplicationDto>>("/api/applications");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading applications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<RentalApplicationDto> FilterApplications()
    {
        if (applications == null) return new();
        var filtered = applications.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(selectedStatus) && int.TryParse(selectedStatus, out int statusValue))
        {
            filtered = filtered.Where(a => (int)a.Status == statusValue);
        }
        return filtered.OrderByDescending(a => a.ApplicationDate).ToList();
    }

    private string GetStatusBadgeClass(ApplicationStatus status) => status switch
    {
        ApplicationStatus.Submitted => "info",
        ApplicationStatus.UnderReview => "warning",
        ApplicationStatus.Approved => "success",
        ApplicationStatus.Rejected => "danger",
        ApplicationStatus.Withdrawn => "secondary",
        _ => "secondary"
    };
}
