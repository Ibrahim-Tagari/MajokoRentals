@using MajokoRentals.Mobile.main.Services
@using System.Text.Json

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>Sync Conflict Detected
                </h5>
                <button type="button" class="btn-close" @onclick="OnCancel"></button>
            </div>
            <div class="modal-body">
                @if (Conflict != null)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>What happened?</strong>
                        <p class="mb-0 mt-2">
                            This @Conflict.EntityType was modified both locally (on your device) and on the server.
                            Please choose which version to keep.
                        </p>
                    </div>

                    <p class="mb-3"><strong>Conflict Details:</strong> @Conflict.Description</p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="card @(selectedVersion == ConflictResolution.KeepLocal ? "border-primary" : "")">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <i class="bi bi-phone me-1"></i>Your Local Version
                                    </h6>
                                </div>
                                <div class="card-body">
                                    @if (Conflict.LocalVersion != null)
                                    {
                                        <pre class="small mb-0" style="max-height: 200px; overflow-y: auto;">@FormatJson(Conflict.LocalVersion)</pre>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">No local changes</p>
                                    }
                                </div>
                                <div class="card-footer">
                                    <button class="btn btn-sm btn-outline-primary w-100"
                                            @onclick="() => SelectVersion(ConflictResolution.KeepLocal)">
                                        <i class="bi bi-check-circle me-1"></i>Keep This Version
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="card @(selectedVersion == ConflictResolution.KeepServer ? "border-primary" : "")">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <i class="bi bi-cloud me-1"></i>Server Version
                                    </h6>
                                </div>
                                <div class="card-body">
                                    @if (Conflict.ServerVersion != null)
                                    {
                                        <pre class="small mb-0" style="max-height: 200px; overflow-y: auto;">@FormatJson(Conflict.ServerVersion)</pre>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">No server changes</p>
                                    }
                                </div>
                                <div class="card-footer">
                                    <button class="btn btn-sm btn-outline-primary w-100"
                                            @onclick="() => SelectVersion(ConflictResolution.KeepServer)">
                                        <i class="bi bi-check-circle me-1"></i>Keep This Version
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (selectedVersion.HasValue)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            You've selected to keep the <strong>@(selectedVersion == ConflictResolution.KeepLocal ? "Local" : "Server")</strong> version.
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary" @onclick="OnResolve" disabled="@(!selectedVersion.HasValue)">
                    <i class="bi bi-check-lg me-1"></i>Resolve Conflict
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public SyncConflict? Conflict { get; set; }

    [Parameter]
    public EventCallback<ConflictResolution> OnResolved { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private ConflictResolution? selectedVersion;

    private void SelectVersion(ConflictResolution resolution)
    {
        selectedVersion = resolution;
    }

    private async Task OnResolve()
    {
        if (selectedVersion.HasValue)
        {
            await OnResolved.InvokeAsync(selectedVersion.Value);
        }
    }

    private async Task OnCancel()
    {
        await OnCancelled.InvokeAsync();
    }

    private string FormatJson(object? obj)
    {
        if (obj == null)
            return "null";

        try
        {
            return JsonSerializer.Serialize(obj, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return obj.ToString() ?? "Unable to format";
        }
    }

    public enum ConflictResolution
    {
        KeepLocal,
        KeepServer
    }
}
