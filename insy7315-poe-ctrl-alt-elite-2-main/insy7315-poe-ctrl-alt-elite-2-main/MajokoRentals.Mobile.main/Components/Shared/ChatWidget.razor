@using MajokoRentals.Core.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IApiClientService ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<!-- Floating Chat Toggle Button -->
<div class="chat-toggle @(isOpen ? "chat-open" : "")" @onclick="ToggleChat">
    @if (isOpen)
    {
        <i class="bi bi-x-lg"></i>
    }
    else
    {
        if (hasUnreadMessages)
        {
            <span class="chat-notification-badge"></span>
        }
        <i class="bi bi-chat-dots-fill"></i>
    }
</div>

<!-- Chat Window -->
<div class="chat-window @(isOpen ? "chat-window-open" : "")">
    <!-- Chat Header -->
    <div class="chat-header">
        <div class="chat-header-left">
            <div class="chat-avatar">
                <i class="bi bi-robot"></i>
            </div>
            <div class="chat-header-info">
                <div class="chat-header-title">Dr Majoko Assistant</div>
                <div class="chat-header-status">
                    <span class="status-indicator"></span>
                    <span>@(currentLang == "zu" ? "Iyatholakala" : "Online")</span>
                </div>
            </div>
        </div>
        <div class="chat-header-right">
            <!-- Language Selector -->
            <select class="chat-lang-selector" @bind="currentLang" @bind:event="onchange">
                <option value="en">EN</option>
                <option value="zu">ZU</option>
            </select>
            <button class="chat-close-btn" @onclick="ToggleChat" type="button">
                <i class="bi bi-dash-lg"></i>
            </button>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="chat-quick-actions">
        <button class="quick-action-btn" @onclick='() => SendQuickAction("help")' type="button">
            <i class="bi bi-question-circle"></i>
            <span>@(currentLang == "zu" ? "Usizo" : "Help")</span>
        </button>
        <button class="quick-action-btn" @onclick='() => SendQuickAction("invoices")' type="button">
            <i class="bi bi-receipt"></i>
            <span>@(currentLang == "zu" ? "Ama-invoice" : "Invoices")</span>
        </button>
        <button class="quick-action-btn" @onclick='() => SendQuickAction("maintenance")' type="button">
            <i class="bi bi-tools"></i>
            <span>@(currentLang == "zu" ? "Ukulungisa" : "Maintenance")</span>
        </button>
        <button class="quick-action-btn" @onclick='() => SendQuickAction("agent")' type="button">
            <i class="bi bi-person-circle"></i>
            <span>@(currentLang == "zu" ? "Umsebenzi" : "Agent")</span>
        </button>
    </div>

    <!-- Chat Messages -->
    <div class="chat-messages" @ref="messagesContainer">
        @if (!messages.Any())
        {
            <!-- Welcome Message -->
            <div class="chat-message bot-message">
                <div class="message-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="message-content">
                    <div class="message-bubble">
                        @if (currentLang == "zu")
                        {
                            <p>Sawubona! 👋 Ngingakusiza kanjani namuhla?</p>
                            <p class="message-hint">Sicela uthi 'usizo' ukubona engingakusiza ngakho.</p>
                        }
                        else
                        {
                            <p>Hi there! 👋 How can I help you today?</p>
                            <p class="message-hint">Try saying 'help' to see what I can assist with.</p>
                        }
                    </div>
                </div>
            </div>
        }

        @foreach (var msg in messages)
        {
            <div class="chat-message @(msg.IsUser ? "user-message" : "bot-message")">
                @if (!msg.IsUser)
                {
                    <div class="message-avatar">
                        <i class="bi bi-robot"></i>
                    </div>
                }
                <div class="message-content">
                    <div class="message-bubble">
                        @((MarkupString)FormatMessage(msg.Text))
                        @if (!string.IsNullOrEmpty(msg.NavigateUrl))
                        {
                            <div class="mt-2">
                                <a href="@msg.NavigateUrl" class="navigation-button" @onclick="() => NavigateAndClose(msg.NavigateUrl)" @onclick:preventDefault="true">
                                    <i class="bi bi-arrow-right-circle me-1"></i>
                                    @(currentLang == "zu" ? "Yiya kukhona" : "Go there")
                                </a>
                            </div>
                        }
                    </div>
                    <div class="message-time">@msg.Timestamp.ToString("HH:mm")</div>
                </div>
                @if (msg.IsUser)
                {
                    <div class="message-avatar user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
            </div>
        }

        @if (isTyping)
        {
            <div class="chat-message bot-message">
                <div class="message-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="message-content">
                    <div class="message-bubble">
                        <div class="typing-indicator">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Chat Input -->
    <div class="chat-input-container">
        <form @onsubmit="SendMessage" @onsubmit:preventDefault="true">
            <div class="chat-input-wrapper">
                <input type="text"
                       class="chat-input"
                       @bind="currentMessage"
                       @bind:event="oninput"
                       placeholder="@(currentLang == "zu" ? "Bhala umlayezo..." : "Type a message...")"
                       disabled="@isSending" />
                <button type="submit" class="chat-send-btn" disabled="@(isSending || string.IsNullOrWhiteSpace(currentMessage))">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill"></i>
                    }
                </button>
            </div>
        </form>
        <div class="chat-footer">
            <small>@(currentLang == "zu" ? "Powered by" : "Powered by") Dr Majoko Projects</small>
        </div>
    </div>
</div>

@code {
    private bool isOpen = false;
    private bool isTyping = false;
    private bool isSending = false;
    private bool hasUnreadMessages = false;
    private string currentMessage = "";
    private string currentLang = "en";
    private List<ChatMessage> messages = new();
    private ElementReference messagesContainer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load saved language preference from localStorage
            try
            {
                var savedLang = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "chatbotLang");
                if (!string.IsNullOrEmpty(savedLang))
                {
                    currentLang = savedLang;
                    StateHasChanged();
                }
            }
            catch { }
        }

        // Scroll to bottom when messages change
        if (isOpen && messages.Any())
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollChatToBottom");
            }
            catch { }
        }
    }

    private void ToggleChat()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            hasUnreadMessages = false;
        }
    }

    private void NavigateAndClose(string url)
    {
        Navigation.NavigateTo(url);
        isOpen = false;
    }

    private async Task SendQuickAction(string action)
    {
        currentMessage = action;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isSending)
            return;

        var userMessage = currentMessage.Trim();
        currentMessage = "";

        // Add user message to chat
        messages.Add(new ChatMessage
        {
            Text = userMessage,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        StateHasChanged();

        // Show typing indicator
        isTyping = true;
        isSending = true;
        StateHasChanged();

        try
        {
            // Save language preference
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chatbotLang", currentLang);

            // Send message to API
            var formData = new Dictionary<string, string>
            {
                { "message", userMessage },
                { "lang", currentLang }
            };

            var response = await ApiClient.PostFormAsync<ChatResponse>("/Chatbot/SendMessage", formData);

            // Hide typing indicator
            isTyping = false;

            if (response != null)
            {
                // Add bot response to chat
                messages.Add(new ChatMessage
                {
                    Text = response.Reply,
                    IsUser = false,
                    Timestamp = DateTime.Now,
                    NavigateUrl = response.NavigateTo
                });

                // Handle escalation
                if (response.Escalated && response.TicketId.HasValue)
                {
                    var escalationMsg = currentLang == "zu"
                        ? $"✓ Ticket #{response.TicketId} idalwe. Sizokuxhumana nawe maduze."
                        : $"✓ Ticket #{response.TicketId} created. We'll contact you shortly.";

                    messages.Add(new ChatMessage
                    {
                        Text = escalationMsg,
                        IsUser = false,
                        Timestamp = DateTime.Now,
                        IsSystemMessage = true
                    });
                }
            }
            else
            {
                // Error handling
                messages.Add(new ChatMessage
                {
                    Text = currentLang == "zu"
                        ? "Uxolo, kunenkinga. Sicela uzame futhi."
                        : "Sorry, something went wrong. Please try again.",
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
            }
        }
        catch (Exception ex)
        {
            isTyping = false;
            messages.Add(new ChatMessage
            {
                Text = currentLang == "zu"
                    ? $"Iphutha: {ex.Message}"
                    : $"Error: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    private string FormatMessage(string text)
    {
        // Convert newlines to <br> tags
        text = text.Replace("\n", "<br>");

        // Basic markdown-like formatting
        // Bold: **text** or __text__
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"__(.+?)__", "<strong>$1</strong>");

        // Italic: *text* or _text_
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\*(.+?)\*", "<em>$1</em>");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"_(.+?)_", "<em>$1</em>");

        return text;
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
        public bool IsSystemMessage { get; set; }
        public string? NavigateUrl { get; set; }
    }

    private class ChatResponse
    {
        [JsonPropertyName("reply")]
        public string Reply { get; set; } = "";

        [JsonPropertyName("escalated")]
        public bool Escalated { get; set; }

        [JsonPropertyName("ticketId")]
        public int? TicketId { get; set; }

        [JsonPropertyName("navigateTo")]
        public string? NavigateTo { get; set; }
    }
}
