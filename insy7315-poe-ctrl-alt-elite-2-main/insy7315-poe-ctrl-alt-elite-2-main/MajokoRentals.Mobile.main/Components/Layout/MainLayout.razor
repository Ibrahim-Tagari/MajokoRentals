@inherits LayoutComponentBase
@using MajokoRentals.Mobile.main.Components.Shared

<div class="page">
    <div class="sidebar @NavMenuCssClass" @onclick="ToggleNavMenu">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-3 d-flex align-items-center">
            <button class="navbar-toggler" @onclick="ToggleNavMenu" type="button" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a href="/" class="navbar-brand ms-2 d-flex align-items-center">
                <img src="images/logo.png" alt="Dr Majoko Projects Logo" style="height: 50px; width: auto; margin-right: 10px;" />
                <span class="d-none d-sm-inline">Dr Majoko Projects</span>
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

    <!-- AI Chatbot Widget -->
    <ChatWidget />
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : "";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
